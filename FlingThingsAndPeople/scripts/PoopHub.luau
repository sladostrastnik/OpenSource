                RemoteEvent.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                RemoteEvent.P = 50000
                RemoteEvent.D = 1000
                RemoteEvent.Position = currentCFrame.Position
                RemoteEvent.Parent = basePart
                local bodyGyro = Instance.new("BodyGyro")
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.P = 50000
                bodyGyro.D = 1000
                bodyGyro.CFrame = currentCFrame
                bodyGyro.Parent = basePart
                table.insert(
                    lines,
                    {part = basePart, model = otherVector.model, index = k, bp = RemoteEvent, bg = bodyGyro, launched = false}
                )
            end
        end

        local keys = runService.Heartbeat:Connect(
            function()
                if not _G.ShieldActive then
                    return
                end
                local characterModel = playerInstance.Character
                characterModel = characterModel and characterModel:FindFirstChild("HumanoidRootPart")
                if not characterModel then
                    return
                end

                for _, currentPlayer in ipairs(lines) do
                    if not currentPlayer.launched and currentPlayer.part and currentPlayer.part.Parent then
                        local currentCFrame = characterModel.CFrame * toyGetOffsetCFrame(batch[currentPlayer.index])

