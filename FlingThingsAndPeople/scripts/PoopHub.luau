                Head = CFrame.new(0, 1.5 + bounce, -laughIntensity * 0.4) * nearestDistance(
                    lower, math.rad(math.sin(laughCycle * 2) * 15), radian(math.sin(laughCycle * 1.5) * 8)
                ),
                ["Left Arm"] = CFrame.new(-0.8, 0.3 + bounce * 0.5, armsForward) * nearestDistance(
