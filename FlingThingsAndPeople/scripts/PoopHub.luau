    CheckForHome = function()
        for k = 1, 5 do
            local rootInstance = workspace.Plots and workspace.Plots:FindFirstChild("Plot" .. k)

            if rootInstance then
                local parentInstance = rootInstance.PlotSign and rootInstance.PlotSign:FindFirstChild(
                    "ThisPlotsOwners"
