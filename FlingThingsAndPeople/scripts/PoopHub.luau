                wheel.NetworkKickQueue[prefix] = nil

                if prefix.Parent and not wheel.Whitelisted[prefix] and not tree[prefix] then
                    table.insert(secondElement, {player = prefix, request = request})
                end
            end

            local top = #secondElement

            for k, request in ipairs(secondElement) do
                local functionReference = request.player

                if functionReference.Parent and not tree[functionReference] then
                    tree[functionReference] = true
                    local parsed, sourceString = pcall(performNetworkKickPass, functionReference, k, top, false)
                    local sortedArray = not parsed

                    if sortedArray or sourceString ~= true then
                        tree[functionReference] = nil
                    end

                    if sortedArray then
                        warn(
                            ("[Resonance Target/Kick] %s: %s"):format(
                                functionReference.Name, tostring(sourceString)
