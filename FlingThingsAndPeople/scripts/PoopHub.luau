Fun.stopHipDanceV2 = function(descendant)
    if Fun.poseConnectionV2 then
        Fun.poseConnectionV2:Disconnect()
        Fun.poseConnectionV2 = nil
    end

    if descendant then
        local targetHumanoid = descendant:FindFirstChildOfClass("Humanoid")

        if targetHumanoid then
            targetHumanoid.PlatformStand = false
            targetHumanoid.AutoRotate = true
        end
    end
end

Fun.startHipDanceV2 = function(descendant)
    if not Fun.activeDanceDataV2 then
        return
    end
    Fun.stopHipDanceV2(descendant)
    local columnIndex = descendant:WaitForChild("HumanoidRootPart")
    local targetHumanoid = descendant:WaitForChild("Humanoid")

    if Fun.RagdollRemote then
        Fun.RagdollRemote:FireServer(columnIndex, 9999999)
    else
        targetHumanoid.PlatformStand = true
        targetHumanoid.AutoRotate = false
    end

    local screenSize = columnIndex.Position
    local originalWalkSpeed = targetHumanoid.WalkSpeed > 0 and targetHumanoid.WalkSpeed or 16
    local elapsedTime = 8
    local columnCount = #Fun.activeDanceDataV2.frames
    if columnCount == 0 then
        return
    end
    Fun.frameIndexV2 = 1
    Fun.frameTimerV2 = 0

    parseCFrameData = function(point)
        return CFrame.new(
            point[1], point[2], point[3], point[4], point[5], point[6], point[7], point[8], point[9],
            point[10], point[11], point[12]
        )
    end

    Fun.poseConnectionV2 = Fun.RunService.Heartbeat:Connect(
        function(alpha)
            if not descendant or not descendant.Parent or not columnIndex or not columnIndex.Parent then
                return
            end
            local mouseLocation = Fun.camera.CFrame.LookVector
            local lower = math.atan2(-mouseLocation.X, -mouseLocation.Z)
            local mouse = columnIndex.Position

            if elapsedTime < (mouse - screenSize).Magnitude then
                screenSize = mouse
            end

            local velocity = targetHumanoid.MoveDirection

            if velocity.Magnitude > 0.01 then
                screenSize += velocity * originalWalkSpeed * alpha
            end

            local currentCFrame = CFrame.new(screenSize) * CFrame.Angles(0, lower, 0)
            columnIndex.CFrame = currentCFrame
            columnIndex.AssemblyLinearVelocity = Vector3.zero
            Fun.frameTimerV2 = Fun.frameTimerV2 + alpha
            local active = false

            if Fun.activeDanceDataV2.interval <= Fun.frameTimerV2 then
                Fun.frameTimerV2 = Fun.frameTimerV2 - Fun.activeDanceDataV2.interval
                Fun.frameIndexV2 = Fun.frameIndexV2 + 1

                if columnCount < Fun.frameIndexV2 then
                    Fun.frameIndexV2 = 1
                    active = true
                end
            end

            local spawnPosition = Fun.activeDanceDataV2.frames[Fun.frameIndexV2]
            local otherVector = Fun.activeDanceDataV2.frames[Fun.frameIndexV2 < columnCount and Fun.frameIndexV2 + 1 or 1]
            active = active and 1 or Fun.frameTimerV2 / Fun.activeDanceDataV2.interval

            for prefix, initialValue in pairs(spawnPosition.parts) do
                if not priorityQueue[prefix] then
                    local rotationAngle = descendant:FindFirstChild(prefix)

                    if rotationAngle and rotationAngle:IsA("BasePart") then
                        local randomYaw = otherVector.parts[prefix] or initialValue
                        rotationAngle.CFrame = currentCFrame * parseCFrameData(initialValue):Lerp(parseCFrameData(randomYaw), active)
                        rotationAngle.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
    )
end

Fun.refreshDanceV2List = function()
    Fun.currentDanceRawTableV2 = {}

    local decoded, sampleText = pcall(
        function()
            return game:HttpGet(
                "https://raw.githubusercontent.com/dcus-official/PoopHub/refs/heads/main/Assets/Emote/List_Json.lua"
            )
        end
    )

    if decoded and sampleText then
        local parsed, sourceString = pcall(
            function()
                local exampleUsage = loadstring(sampleText)
                if exampleUsage then
                    return exampleUsage()
                end
            end
        )

        if parsed and type(sourceString) == "table" then
            for prefix, char in pairs(sourceString) do
                Fun.currentDanceRawTableV2[prefix] = char
            end
        end
    end

    if not isfolder("PoopHub") then
        makefolder("PoopHub")
    end

    if not isfolder("PoopHub/FTAP") then
        makefolder("PoopHub/FTAP")
    end

    if not isfolder("PoopHub/FTAP/Emote") then
        makefolder("PoopHub/FTAP/Emote")
    end

    local parsed, sourceString = pcall(
        function()
            return listfiles("PoopHub/FTAP/Emote")
        end
    )

    if parsed and type(sourceString) == "table" then
        for _, char in ipairs(sourceString) do
            if char:match("%.dance$") then
                local targetName = char:gsub("\\", "/"):match("([^/]+)%.dance$")

                if targetName then
                    local decodeSuccess, bestAction = pcall(
                        function()
                            return readfile(char)
                        end
                    )

                    if decodeSuccess and bestAction then
                        Fun.currentDanceRawTableV2[targetName] = bestAction
                    end
                end
            end
        end
    end

    table.clear(Fun.danceListV2)

    for prefix in pairs(Fun.currentDanceRawTableV2) do
        table.insert(Fun.danceListV2, prefix)
    end

    table.sort(Fun.danceListV2)

    if #Fun.danceListV2 == 0 then
        table.insert(Fun.danceListV2, "No dances found")
    end

    if optionContainer.DanceV2Dropdown then
        optionContainer.DanceV2Dropdown:SetValues(Fun.danceListV2)

        if #Fun.danceListV2 > 0 and Fun.danceListV2[1] ~= "No dances found" then
            optionContainer.DanceV2Dropdown:SetValue(Fun.danceListV2[1])
        end
    end
end

