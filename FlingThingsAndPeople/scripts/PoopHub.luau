IsInPlot = function(descendant)
    if not descendant then
        return false
    end
    local workerCount = descendant:FindFirstChild("InPlot")
    if workerCount and workerCount:IsA("BoolValue") then
        return workerCount.Value
    end
    local results = descendant:GetAttribute("InPlot")
    if typeof(results) == "boolean" then
        return results
    end
    local characterModel = descendant.Character
    if not characterModel then
        return false
    end
    local columnIndex = characterModel:FindFirstChild("HumanoidRootPart") or characterModel:FindFirstChild(
        "Torso"
    )
    if not columnIndex then
        return false
    end
    local rootInstance = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("PlayerPlots") or workspace:FindFirstChild(
        "Houses"
    ) or workspace:FindFirstChild("PlotsFolder")
    if not rootInstance then
        return false
    end
    local spawnPosition = nil

    for _, newPart in ipairs(rootInstance:GetChildren()) do
        if newPart:IsA("Model") then
            local angle = newPart:GetAttribute("OwnerUserId") or newPart:GetAttribute("OwnerId")
            local sortedArray = typeof(angle) == "number" and angle == descendant.UserId
            local cost = false

            if sortedArray then
                cost = true
            end

            if not cost then
                local valueType = newPart:GetAttribute("OwnerName")

                if typeof(valueType) == "string" and valueType == descendant.Name then
                    cost = true
                end
            end

            if not cost then
                local stringValue = newPart:FindFirstChild("Owner") or newPart:FindFirstChild("PlotOwner")

                if stringValue then
                    if stringValue:IsA("ObjectValue") and stringValue.Value == descendant or stringValue:IsA("IntValue") and stringValue.Value == descendant.UserId or stringValue:IsA(
                        "StringValue"
                    ) and stringValue.Value == descendant.Name then
                        cost = true
                    end
                end
            end

            if not cost then
                local scoreValue = newPart:FindFirstChild("OwnerUserId") or newPart:FindFirstChild(
                    "OwnerId"
                )

                if scoreValue and scoreValue:IsA("IntValue") and scoreValue.Value == descendant.UserId then
                    cost = true
                end
            end

            if not cost then
                if newPart.Name == descendant.Name or newPart.Name == tostring(descendant.UserId) then
                    cost = true
                end
            end

            if cost then
                spawnPosition = newPart
                break
            else
                spawnPosition = nil
            end
        else
            spawnPosition = nil
        end
    end

    if not spawnPosition then
        for _, projectile in ipairs(rootInstance:GetDescendants()) do
            if projectile:IsA("Model") then
                local angle = projectile:GetAttribute("OwnerUserId") or projectile:GetAttribute(
                    "OwnerId"
                )
                local sortedArray = typeof(angle) == "number" and angle == descendant.UserId
                local cost = false

                if sortedArray then
                    cost = true
                end

                local changed

                if not cost then
                    local valueType = projectile:GetAttribute("OwnerName")

                    if typeof(valueType) == "string" and valueType == descendant.Name then
                        changed = true
                    else
                        changed = cost
                    end
                else
                    changed = cost
                end

                if not changed then
                    local stringValue = projectile:FindFirstChild("Owner") or projectile:FindFirstChild(
                        "PlotOwner"
                    )

                    if stringValue then
                        if stringValue:IsA("ObjectValue") and stringValue.Value == descendant or stringValue:IsA("IntValue") and stringValue.Value == descendant.UserId or stringValue:IsA(
                            "StringValue"
                        ) and stringValue.Value == descendant.Name then
                            changed = true
                        end
                    end
                end

                if not changed then
                    local scoreValue = projectile:FindFirstChild("OwnerUserId") or projectile:FindFirstChild(
                        "OwnerId"
                    )

                    if scoreValue and scoreValue:IsA("IntValue") and scoreValue.Value == descendant.UserId then
                        changed = true
                    end
                end

                local first

                if not changed then
                    if projectile.Name == descendant.Name or projectile.Name == tostring(descendant.UserId) then
                        first = true
                    else
                        first = changed
                    end
                else
                    first = changed
                end

                if first then
                    spawnPosition = projectile
                    break
                end
            end
        end
    end

    if not spawnPosition then
        return false
    end
    local otherVector = nil

    for _, hitbox in ipairs(
        {"PlotArea", "Area", "Region", "Bounds", "Boundary", "Base", "Baseplate", "HouseArea"}
    ) do
        otherVector = spawnPosition:FindFirstChild(hitbox, true)
        if not (otherVector and otherVector:IsA("BasePart")) then
            otherVector = nil
            continue
        end
        break
    end

    if otherVector then
        local rotationAngle = otherVector.CFrame:PointToObjectSpace(columnIndex.Position)
        local top = otherVector.Size * 0.5
        local maxX = top.X
        local sortedArray = math.abs(rotationAngle.X) <= maxX

        if sortedArray then
            local maxY = top.Y
            sortedArray = math.abs(rotationAngle.Y) <= maxY
        end

        if sortedArray then
            local maxZ = top.Z
            sortedArray = math.abs(rotationAngle.Z) <= maxZ
        end

        return sortedArray
    end

    local parts, rotationAngle = spawnPosition:GetBoundingBox()
    local randomYaw = parts:PointToObjectSpace(columnIndex.Position)
    local top = (rotationAngle + Vector3.new(6, 10, 6)) * 0.5
    local maxX = top.X
    local sortedArray = math.abs(randomYaw.X) <= maxX

    if sortedArray then
        local maxY = top.Y
        sortedArray = math.abs(randomYaw.Y) <= maxY
    end

    if sortedArray then
        local maxZ = top.Z
        sortedArray = math.abs(randomYaw.Z) <= maxZ
    end

    return sortedArray
end

