            Placeholder = "Asset ID...",
            Callback = function(descendant)
                content = descendant:match("^%s*(.-)%s*$") or ""

                if changed and content ~= "" then
                    updateAuraLogic()
                end
            end,
        }
    )

    result51:AddSlider(
        "LocalAuraRateMult",
        {
            Text = "Particle Rate Multiplier", Min = 0.1, Max = 10, Default = 1, Rounding = 1,
            Callback = function(descendant)
