    noksApplyBoxFillColor = function(descendant)
        local offsetX = (100 - grid.noksBoxFillOpacity1) / 100
        local top = (100 - grid.noksBoxFillOpacity2) / 100

        if grid.noksBoxFill then
            descendant.Box.BackgroundColor3 = grid.noksGradientColor1
            descendant.Box.BackgroundTransparency = offsetX

            if grid.noksGradientFill then
                descendant.FillGrad.Color = ColorSequence.new(
                    grid.noksGradientColor1, grid.noksGradientColor2
                )
                local beam = descendant.FillGrad
                local result18 = NumberSequence.new
                local sorted = {}
                local spawnPosition = NumberSequenceKeypoint.new(0, offsetX)
                local result13 = NumberSequenceKeypoint.new
                sorted[1] = spawnPosition

                do
                    local argumentPack = table.pack(result13(1, top))
                    table.move(argumentPack, 1, argumentPack.n, 2, sorted)
                end

                beam.Transparency = result18(sorted)

                if grid.noksGradientRotate then
                    descendant.FillGrad.Rotation = (descendant.FillGrad.Rotation + grid.noksRotateSpeed) % 360
                end

                descendant.FillGrad.Enabled = true
            else
                descendant.FillGrad.Enabled = false
            end
        else
            descendant.FillGrad.Enabled = false
            descendant.Box.BackgroundTransparency = 1
        end
    end

    noksApplyLineColor = function(descendant)
        descendant.LineFrame.BackgroundColor3 = grid.noksLineColor1

        if grid.noksLineGradient then
            descendant.LineGrad.Color = ColorSequence.new(grid.noksLineColor1, grid.noksLineColor2)
            descendant.LineGrad.Enabled = true
        else
            descendant.LineGrad.Enabled = false
        end
    end

    noksApplyHealthBarColor = function(descendant)
        local progress = descendant.LastHealthRatio
        descendant.HealthBarVisual.BackgroundColor3 = Color3.fromRGB(255, 40, 40):Lerp(
            Color3.fromRGB(0, 255, 120), progress
        )

        if grid.noksHealthGradient then
            local particleEmitter = descendant.HealthBarGrad
            local safeCall = ColorSequence.new
            local sorted = {}
            local spawnPosition = ColorSequenceKeypoint.new(0, grid.noksHealthGrad3)
            local otherVector = ColorSequenceKeypoint.new(0.5, grid.noksHealthGrad2)
            local result13 = ColorSequenceKeypoint.new
            local player138 = grid.noksHealthGrad1
            sorted[1] = spawnPosition
            sorted[2] = otherVector

            do
                local argumentPack = table.pack(result13(1, player138))
                table.move(argumentPack, 1, argumentPack.n, 3, sorted)
            end

            particleEmitter.Color = safeCall(sorted)
            descendant.HealthBarGrad.Enabled = true
        else
            descendant.HealthBarGrad.Enabled = false
        end
    end

    noksUpdateNameGrad = function(descendant, point, object)
        local spawnPosition = emitterInstance[point]
        if not spawnPosition then
            return
        end
        local top = grid.noksNameScrollSpeed / 10

        if grid.noksNameGradient then
            spawnPosition.offset = spawnPosition.offset + top * object * spawnPosition.direction

            if spawnPosition.offset >= 1 then
                spawnPosition.offset = 1
                spawnPosition.direction = -1
            elseif spawnPosition.offset <= 0 then
                spawnPosition.offset = 0
                spawnPosition.direction = 1
            end

            local player169 = grid.noksTextGradColor1
            local player171 = grid.noksTextGradColor2
            local trail = descendant.NameGrad
            local safeCall = ColorSequence.new
            local sorted = {}
            local otherVector = ColorSequenceKeypoint.new(0, player169)
            local rotationAngle = ColorSequenceKeypoint.new(0.5, player171)
            local result13 = ColorSequenceKeypoint.new
            sorted[1] = otherVector
            sorted[2] = rotationAngle

            do
                local argumentPack = table.pack(result13(1, player169))
                table.move(argumentPack, 1, argumentPack.n, 3, sorted)
            end

            trail.Color = safeCall(sorted)
            descendant.NameGrad.Offset = Vector2.new(-spawnPosition.offset, 0)
            descendant.NameGrad.Enabled = true
            descendant.NameLabel.TextColor3 = grid.noksNameColor
        elseif spawnPosition.offset > 0.001 then
            spawnPosition.offset = math.max(0, spawnPosition.offset - top * object)
            local player169 = grid.noksTextGradColor1
            local player171 = grid.noksTextGradColor2
            local trail = descendant.NameGrad
            local safeCall = ColorSequence.new
            local sorted = {}
            local otherVector = ColorSequenceKeypoint.new(0, player169)
            local rotationAngle = ColorSequenceKeypoint.new(0.5, player171)
            sorted[1] = otherVector
            sorted[2] = rotationAngle

            do
                local argumentPack = table.pack(ColorSequenceKeypoint.new(1, player169))
                table.move(argumentPack, 1, argumentPack.n, 3, sorted)
            end

            trail.Color = safeCall(sorted)
            descendant.NameGrad.Offset = Vector2.new(-spawnPosition.offset, 0)
            descendant.NameGrad.Enabled = true
            descendant.NameLabel.TextColor3 = grid.noksNameColor
        else
            spawnPosition.offset = 0
            spawnPosition.direction = 1
            descendant.NameGrad.Enabled = false
            descendant.NameLabel.TextColor3 = grid.noksNameColor
        end
    end

    triggerNoksFadeOut = function(descendant, point, object, v)
        if grid.noksFadeOutEnable and point.Gui.Enabled then
            local tool = point.Gui:Clone()
            tool.Name = "Noks_FadeInstance_" .. descendant.Name
            tool.Parent = game:GetService("CoreGui")
            local textButton = tool:FindFirstChildOfClass("CanvasGroup")

            table.insert(
                openSet,
                {
                    Gui = tool, Canvas = textButton, Snapshot = noksSnapshotTransparencies(tool),
                    FadeStartTime = object, WorldPosition = v,
                    DeathHeight = point.LastSize and point.LastSize.Y.Offset or 60,
                    DeathWidth = point.LastSize and point.LastSize.X.Offset or 40,
                    CloneBox = textButton and textButton:FindFirstChild("Noks_Box"),
                    CloneHealthBg = textButton and textButton:FindFirstChild("Noks_HealthBg"),
                    CloneNameLabel = textButton and textButton:FindFirstChild("NameLabel"),
                    CloneHpLabel = textButton and textButton:FindFirstChild("Noks_HpLabel"),
                    CloneDist = textButton and textButton:FindFirstChild("Noks_Dist"),
                    CloneLine = textButton and textButton:FindFirstChild("Noks_Line"),
                    CloneFlags = textButton and textButton:FindFirstChild("Noks_Flags"),
                    LastHealthRatio = point.LastHealthRatio,
                    BoxFillGradRotation = point.FillGrad.Rotation,
                    NameGradientOffset = emitterInstance[descendant] and emitterInstance[descendant].offset or 0,
                    NameGradientDirection = emitterInstance[descendant] and emitterInstance[descendant].direction or 1,
                    LastUpdate = object,
                }
            )
        end

        point.Gui.Enabled = false
    end

