syncRecoveredProperties = function(descendant, point)
    for prefix, request in next, point, nil do
        if descendant[prefix] ~= request then
            local ray = descendant[prefix]

            if type(ray) ~= "number" then
                descendant[prefix] = request
            elseif type(request) ~= "number" then
                descendant[prefix] = request
            elseif math.abs(ray - request) > 1e-05 then
                descendant[prefix] = request
            end
        end
    end
end

