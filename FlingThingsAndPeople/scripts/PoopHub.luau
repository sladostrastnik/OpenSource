                            elseif otherVector.NameGradientOffset <= 0 then
                                otherVector.NameGradientOffset = 0
                                otherVector.NameGradientDirection = 1
                            end

                            surfaceAppearance.Offset = Vector2.new(-otherVector.NameGradientOffset, 0)
                        end
                    end
                end
            end
        end
    )
end

