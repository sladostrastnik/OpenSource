            end
        end

        task.wait(0.3)
        local columnCount = columnIndex.CFrame * CFrame.new(0, 0, -3)

        for _, currentPlayer in ipairs(playerList) do
            pcall(
                function()
                    BuoyancyRemoteFunction:InvokeServer(currentPlayer, columnCount, Vector3.zero)
                end
