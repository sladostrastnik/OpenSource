                        function()
                            if ray.Parent then
                                currentCFrame = ray.CFrame
                                ray.CFrame = Graph
                            end
                        end
                    )
                end

                invokeSpawn = function()
                    fireRemote(result32.spawnEvent, descendant, top, rotation)
                end

                task.spawn(invokeSpawn)
                local previousTime = tick()

                while true do
                    runService.Heartbeat:Wait()

                    if sortedArray then
                        task.spawn(invokeSpawn)
                    end

                    local shooter = newPlayer
                    local changed

                    if newPlayer then
                        changed = shooter
                    else
                        changed = tick() - previousTime > 1.3
                    end

                    if not changed then
