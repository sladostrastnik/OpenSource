    buildSnow = function()
        destroySnow()
        previous = Instance.new("Model", workspace)
        previous.Name = "_PoophubSnowSystem"
        stepPart = Instance.new("Part", previous)
        stepPart.Name = "SNOWPART"
        stepPart.Anchored = true
        stepPart.CanCollide = false
        stepPart.Transparency = 1
        stepPart.Size = Vector3.new(emitterInstance.PartSize, 1, emitterInstance.PartSize)

        mk = function()
            local particle = Instance.new("ParticleEmitter", stepPart)
            particle.Texture = "rbxassetid://118641183"
            particle.Color = ColorSequence.new(emitterInstance.Color)
            particle.Enabled = true
            particle.Rate = emitterInstance.Rate
            particle.Speed = NumberRange.new(emitterInstance.SpeedMin, emitterInstance.SpeedMax)
            particle.Lifetime = NumberRange.new(emitterInstance.LifeMin, emitterInstance.LifeMax)
            particle.Size = NumberSequence.new(emitterInstance.SizeStart, emitterInstance.SizeEnd)
            particle.Transparency = NumberSequence.new(0, 1)
            particle.EmissionDirection = Enum.NormalId.Bottom
            particle.Shape = Enum.ParticleEmitterShape.Box
            particle.Acceleration = Vector3.new(0, -emitterInstance.Gravity, 0)
            particle.Drag = 1
            particle.LightInfluence = 1
            particle.Rotation = NumberRange.new(0, 360)
            particle.SpreadAngle = Vector2.new(emitterInstance.Spread, emitterInstance.Spread)
            return particle
        end

        for k = 1, emitterInstance.Count do
            table.insert(beamInstance, mk())
        end

        sortedArray = true
