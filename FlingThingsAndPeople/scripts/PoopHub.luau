handleChaosGrab = function(descendant, point)
    pcall(
        function()
            local primaryPart = descendant:FindFirstChild("GrabPart")
            if not primaryPart then
                return
            end
            local RemoteEvent = Instance.new("BodyPosition")
            RemoteEvent.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            RemoteEvent.Parent = primaryPart
            local bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bodyGyro.Parent = primaryPart

            task.spawn(
                function()
                    while point() do
                        pcall(
                            function()
                                local randomIndex = math.random
                                RemoteEvent.Position = primaryPart.Position + Vector3.new(
                                    math.random(-50, 50), math.random(-50, 50), randomIndex(-50, 50)
                                )
                                local radian = math.rad
                                local mathRandom = math.random
                                bodyGyro.CFrame = CFrame.Angles(
                                    math.rad(math.random(-180, 180)),
                                    math.rad(math.random(-180, 180)), radian(mathRandom(-180, 180))
                                )
                            end
                        )

                        task.wait(0.1)
                    end

                    RemoteEvent:Destroy()
                    bodyGyro:Destroy()
                end
            )
        end
    )
