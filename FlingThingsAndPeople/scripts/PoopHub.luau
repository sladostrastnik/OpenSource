getKickTargets = function()
    local batch = {}
    local result7 = grid.kickTargetPlayerDisplay
    local spawnPosition = ExtractUsername(result7)

    for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
        if playerObject ~= playerInstance then
            local withinY = grid.kickExcludeFriends and playerInstance:IsFriendsWith(
                playerObject.UserId
            )
            local sortedArray = false

            if withinY then
                sortedArray = true
            end

            if grid.kickUseWhitelist and isWhitelisted(playerObject) then
                sortedArray = true
            end

