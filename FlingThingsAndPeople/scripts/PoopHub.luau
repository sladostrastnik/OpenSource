Fun.makeProceduralDance = function(descendant)
    return function(point)
        Fun.stopPose()
        rootPart = point:WaitForChild("HumanoidRootPart")
        humanoid = point:WaitForChild("Humanoid")
        Fun.RagdollRemote:FireServer(rootPart, 9999999)
        movePosition = rootPart.Position
        walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
        teleportThreshold = 8
        Fun.activeMode = "dance"

        Fun.poseConnection = Fun.RunService.Heartbeat:Connect(
            function(alpha)
                if not point or not point.Parent or not rootPart or not rootPart.Parent then
                    Fun.stopPose()
                    return
                end
                t = tick()
                cameraLook = Fun.camera.CFrame.LookVector
                yawAngle = math.atan2(-cameraLook.X, -cameraLook.Z)
                actualPosition = rootPart.Position

                if (actualPosition - movePosition).Magnitude > teleportThreshold then
                    movePosition = actualPosition
                end

                moveDir = humanoid.MoveDirection

                if moveDir.Magnitude > 0.01 then
                    movePosition = movePosition + moveDir * walkSpeed * alpha
                end

                targetCFrame = CFrame.new(movePosition) * CFrame.Angles(0, yawAngle, 0)
                rootPart.CFrame = targetCFrame
                phase = t * descendant.speed
                offsets = descendant.pose(phase)

                for prefix, char in pairs(offsets) do
                    part = point:FindFirstChild(prefix)

                    if part and part:IsA("BasePart") then
                        part.CFrame = targetCFrame * char
                        part.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        )
    end
end

