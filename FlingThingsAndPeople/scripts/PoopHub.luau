                    "Left Arm", "Right Leg", "Left Leg",
                }, Default = "Auto", Multi = false, Text = modelTemplate .. " Target",
                Callback = function(descendant)
                    voteCount[modelTemplate] = descendant

                    if changed and type(openSet) == "table" and openSet[modelTemplate] then
                        enableAura()
