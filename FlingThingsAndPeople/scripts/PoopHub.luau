parent.ChildAdded:Connect(
    function(sound)
        if sound.Name ~= "Part" or not properties.AntiExplosion or not sound:IsA("BasePart") then
            return
        end
        local packed, ray, Character = emitterInstance.charp()
        if not packed or not ray or not Character or (sound.Position - ray.Position).Magnitude > 20 then
            return
        end
        ray.Anchored = true
        task.wait(0.02)

        if not Character.SeatPart then
            Character.Sit = false
        end

        local newPlayer = nil

        pcall(
            function()
                newPlayer = packed:QueryDescendants("#RagdollLimbPart")
            end
        )

        if newPlayer then
            for _, listener in pairs(newPlayer) do
                listener.CanCollide = false
            end
        else
            for _, projectile in ipairs(packed:GetDescendants()) do
                if projectile:IsA("BasePart") and (projectile.Name == "RagdollLimbPart" or projectile:GetAttribute(
                    "RagdollLimbPart"
                )) then
                    projectile.CanCollide = false
                end
            end
        end

        emitterInstance.resetVelocity(ray)
        ray.Anchored = false
    end
)

bindAntiBurn = function(descendant)
    local columnIndex = descendant and descendant:WaitForChild("HumanoidRootPart", 2)
    if not columnIndex then
        return
    end

    columnIndex.ChildAdded:Connect(
        function(sound)
            if sound.Name ~= "FireParticleEmitter" or not properties.AntiBurn then
                return
            end
            local packed = getMap()
            local hitboxPart = packed and packed:FindFirstChild("Hole")
            hitboxPart = hitboxPart and hitboxPart:FindFirstChild("PoisonSmallHole")
            hitboxPart = hitboxPart and hitboxPart:FindFirstChild("ExtinguishPart")
            if not hitboxPart or not hitboxPart:IsA("BasePart") then
                return
            end
            local currentCFrame = hitboxPart.CFrame
            local joint = columnIndex:FindFirstChild("FireLight")

            if joint then
                joint:Destroy()
            end

            if sound:IsA("ParticleEmitter") then
                sound.Enabled = false
            end

            local Terrain = playerInstance:FindFirstChildOfClass("PlayerGui")
            Terrain = Terrain and Terrain:FindFirstChild("ScreenOverlayGui")
            Terrain = Terrain and Terrain:FindFirstChild("FireFade")

            if Terrain and Terrain:IsA("GuiObject") then
                Terrain.Visible = false
            end

            while sound and sound.Parent and columnIndex.Parent do
                hitboxPart.CFrame = columnIndex.CFrame
                task.wait()
            end

            if hitboxPart.Parent then
                hitboxPart.CFrame = currentCFrame
            end
        end
    )
end

