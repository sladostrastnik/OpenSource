shieldObeyTarget = function(descendant, point)
    if not descendant or not descendant.part or not descendant.part.Parent then
        return
    end
    local previous = descendant.model
    local basePart = descendant.part
    descendant.launched = true

    if descendant.bp then
        descendant.bp.MaxForce = Vector3.zero
    end

    if descendant.bg then
        descendant.bg.MaxTorque = Vector3.zero
    end

    task.spawn(
        function()
            local hit = previous and previous:FindFirstChild("Button")

            if hit then
                pcall(
                    function()
                        AntiCheatEvent:FireServer(hit, hit.CFrame)
                    end
                )

                task.wait(0.05)
            end

            pcall(
                function()
                    AntiCheatEvent:FireServer(basePart, basePart.CFrame)
                end
            )

            task.wait(0.05)
            local keys = nil

            keys = runService.Heartbeat:Connect(
                function()
                    if not basePart or not basePart.Parent or not point or not point.Parent then
                        if keys then
                            keys:Disconnect()
                        end

                        return
                    end

                    pcall(
                        function()
                            if hit and hit.Parent then
                                AntiCheatEvent:FireServer(hit, point.CFrame)
                            end

                            AntiCheatEvent:FireServer(basePart, point.CFrame)
                            basePart.CFrame = point.CFrame
                            basePart.AssemblyLinearVelocity = Vector3.zero
                            basePart.AssemblyAngularVelocity = Vector3.zero
                        end
                    )
                end
            )
        end
    )
end

getRandomBombData = function()
    local edges = {}

    for _, definition in ipairs(lines) do
        if definition.index >= 3 and not definition.launched then
            table.insert(edges, definition)
        end
    end

    if #edges == 0 then
        return nil
    end
    return edges[math.random(1, #edges)]
end

