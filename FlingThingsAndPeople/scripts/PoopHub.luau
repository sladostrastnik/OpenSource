                        if not ray.Parent then
                            return
                        end
                    end
                end

                local nearestDistance = sortedArray and CFrame.new(0, 25, 0) or ray.CFrame + Vector3.new(0, 15, 0)
                local top = CFrame.new((typeof(point) == "CFrame" and point or nearestDistance).Position) + Vector3.new(
                    0, 0, 20
                )
                local TattooImageLabel = parent:FindFirstChild("RotateOrientPart")
                local rotation = TattooImageLabel and TattooImageLabel.Rotation or Vector3.zero

                keys = Character.ChildAdded:Connect(
                    function(sound)
                        if sound.Name == descendant then
                            newPlayer = sound

                            if keys then
                                keys:Disconnect()
                                keys = nil
                            end
                        end
                    end
                )

                currentCFrame = ray.CFrame

                if sortedArray then
                    local Graph = CFrame.new(0, 10, 0)

                    pcall(
