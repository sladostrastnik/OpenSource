GetRepresentativePart = function(descendant, point)
    if not descendant then
        return nil
    end

    findAny = function(object)
        for _, childName in ipairs(object) do
            local lower = descendant:FindFirstChild(childName)
            if lower and lower:IsA("BasePart") then
                return lower
            end
        end
    end

    if point == "Head" then
        return findAny({"Head"})
    end

    if point == "HumanoidRootPart" then
        return findAny({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"})
    end

    if point == "Left Arm" then
        return findAny({"LeftHand", "LeftUpperArm", "Left Arm", "LeftLowerArm"})
    end

    if point == "Right Arm" then
        return findAny({"RightHand", "RightUpperArm", "Right Arm", "RightLowerArm"})
    end

    if point == "Left Leg" then
        return findAny({"LeftFoot", "LeftLowerLeg", "Left Leg", "LeftUpperLeg"})
    end

    if point == "Right Leg" then
        return findAny({"RightFoot", "RightLowerLeg", "Right Leg", "RightUpperLeg"})
    end
end

