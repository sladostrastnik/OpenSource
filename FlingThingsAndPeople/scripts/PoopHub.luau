    processInstance = function(descendant)
        if emitterInstance[descendant] then
            return
        end

        if descendant:IsA("Model") and string.find(string.lower(descendant.Name), "blackhole") then
            local beamInstance = {
                large = nil, small = nil, hole = nil, originalLargeImage = "",
                originalLargeImageColor3 = Color3.new(1, 1, 1), originalLargeImageTrans = 0,
                originalSmallVisible = true, originalHoleTransparency = 0,
            }

            emitterInstance[descendant] = beamInstance

            applyToChild = function(overlay)
                if overlay.Name == "Large" and (overlay:IsA("ImageLabel") or overlay:IsA("ImageButton")) then
                    if not beamInstance.large then
                        beamInstance.large = overlay
                        beamInstance.originalLargeImage = overlay.Image
                        beamInstance.originalLargeImageColor3 = overlay.ImageColor3
                        beamInstance.originalLargeImageTrans = overlay.ImageTransparency
                    end

                    if grid.customBlackholeEnabled and characters ~= "" then
                        overlay.Image = characters
                        overlay.ImageColor3 = Color3.new(1, 1, 1)
                        overlay.ImageTransparency = 0
                        overlay.Visible = true

                        pcall(
                            function()
                                overlay.ResampleMode = Enum.ResamplerMode.Pixelated
                            end
                        )
                    end
                elseif overlay.Name == "Small" and (overlay:IsA("ImageLabel") or overlay:IsA(
                    "ImageButton"
                )) then
                    if not beamInstance.small then
                        beamInstance.small = overlay
                        beamInstance.originalSmallVisible = overlay.Visible
                    end

                    if grid.customBlackholeEnabled then
                        overlay.Visible = false
                    end
                elseif overlay.Name == "Hole" and overlay:IsA("BasePart") then
                    if not beamInstance.hole then
                        beamInstance.hole = overlay
                        beamInstance.originalHoleTransparency = overlay.Transparency
                    end

                    if grid.customBlackholeEnabled then
                        overlay.Transparency = 1
                    end
                end
            end

            for _, projectile in ipairs(descendant:GetDescendants()) do
                applyToChild(projectile)
            end

            local keys = descendant.DescendantAdded:Connect(
                function(rowIndex)
                    applyToChild(rowIndex)
                end
            )

            local heartbeatConnection = nil

            heartbeatConnection = descendant.AncestryChanged:Connect(
                function(sound, Lighting)
                    if not Lighting then
                        emitterInstance[descendant] = nil
                        keys:Disconnect()
                        heartbeatConnection:Disconnect()
                    end
                end
            )
        end
    end
end

