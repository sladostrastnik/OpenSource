        task.wait(0.3)
        local edgeList = {}
        local offsetZ = 0

        for _, newPart in ipairs(spawnPosition:GetChildren()) do
            if newPart.Name == "GlassBoxGray" and not edgeList[1] then
                local otherVector = toyGetShieldMainPart(newPart)

                if otherVector then
                    edgeList[1] = {part = otherVector, model = newPart}
                end
            elseif newPart.Name == "PalletLightBrown" and not edgeList[2] then
                local otherVector = toyGetShieldMainPart(newPart)

                if otherVector then
                    edgeList[2] = {part = otherVector, model = newPart}
                end
            elseif newPart.Name == "BombMissile" and offsetZ < 6 then
