runAura = function(descendant, point)
    local active = false

    while point() do
        task.wait(0.01)
        local EquipmentSlot, lower = getCharInfo()

        if lower then
            local spawnPosition = spawnBlobmanIfNeeded()

            if spawnPosition then
                sitOnBlobman(spawnPosition)
                local remoteEvent = spawnPosition:FindFirstChild("BlobmanSeatAndOwnerScript")
                local encoded = spawnPosition:FindFirstChild("LeftDetector")
                local encryptedPayload = encoded and encoded:FindFirstChild("LeftWeld")

                if remoteEvent and encoded and encryptedPayload then
                    local intersect = remoteEvent:FindFirstChild("CreatureGrab")
                    local middle = remoteEvent:FindFirstChild(
                        "CreatureRelease"
                    )
                    local PlayerGui = remoteEvent:FindFirstChild("CreatureDrop")

                    if intersect and middle and PlayerGui then
                        active = not active

                        for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
                            if point() then
                                if playerObject ~= playerInstance and not isWhitelisted(playerObject) then
                                    local characterModel = playerObject.Character
                                    local columnIndex = characterModel and characterModel:FindFirstChild(
                                        "HumanoidRootPart"
                                    )
                                    local targetHumanoid = characterModel and characterModel:FindFirstChildOfClass(
                                        "Humanoid"
                                    )

                                    if columnIndex and targetHumanoid and (lower.Position - columnIndex.Position).Magnitude <= 30 then
                                        pcall(
                                            function()
                                                intersect:FireServer(
                                                    encoded, columnIndex, encryptedPayload
                                                )
                                                middle:FireServer(
                                                    encryptedPayload, columnIndex
                                                )
                                                PlayerGui:FireServer(encryptedPayload, columnIndex)

                                                if descendant then
                                                    targetHumanoid.Health = active and 0 or 100
                                                end
                                            end
                                        )
                                    end
                                end

                                continue
                            end

                            break
                        end
                    end
                end
            end
        end
    end
end

