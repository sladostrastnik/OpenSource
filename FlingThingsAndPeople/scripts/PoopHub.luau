    performNetworkKickPass = function(descendant, point, object, v)
        if PlayerExtension.NetworkKick then
            return PlayerExtension.NetworkKick(
                descendant, v == true, false, beamInstance, properties, wheel
            )
        end

        if typeof(descendant) ~= "Instance" or not descendant:IsA("Player") or descendant == playerInstance or not descendant.Parent then
            return false
