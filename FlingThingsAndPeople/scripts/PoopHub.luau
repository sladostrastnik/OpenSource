task.spawn(
    function()
        while true do
            task.wait(0.01)

            if grid.wasdControlEnabled and grid.rebuildActive then
                pcall(
                    function()
                        local currentCFrame = workspace.CurrentCamera.CFrame
                        local directionVector = Vector3.new(currentCFrame.LookVector.X, 0, currentCFrame.LookVector.Z).Unit
                        local directionToTarget = Vector3.new(currentCFrame.RightVector.X, 0, currentCFrame.RightVector.Z).Unit
                        local steer = Vector3.zero

                        if UIS:IsKeyDown(Enum.KeyCode.W) then
                            steer = Vector3.zero + directionVector
                        end

                        if UIS:IsKeyDown(Enum.KeyCode.S) then
                            steer -= directionVector
                        end

                        if UIS:IsKeyDown(Enum.KeyCode.A) then
                            steer -= directionToTarget
                        end

                        if UIS:IsKeyDown(Enum.KeyCode.D) then
                            steer += directionToTarget
                        end

                        if UIS:IsKeyDown(Enum.KeyCode.Space) then
                            steer += Vector3.new(0, 1, 0)
                        end

                        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                            steer -= Vector3.new(0, 1, 0)
                        end

                        local characterModel = playerInstance.Character
                        characterModel = characterModel and characterModel:FindFirstChildOfClass("Humanoid")

                        if characterModel then
                            local velocity = characterModel.MoveDirection

                            if velocity.Magnitude > 0.1 then
                                local toTarget = Vector3.new(velocity.X, 0, velocity.Z)

                                if toTarget.Magnitude > 0 then
                                    steer += toTarget.Unit
                                end
                            end
                        end

                        if grid.verticalMoveAmount ~= 0 then
                            steer += Vector3.new(0, grid.verticalMoveAmount, 0)
                        end

                        if steer.Magnitude > 0 then
                            result41.partsPosition = result41.partsPosition + steer.Unit * grid.wasdMoveSpeed
                        end
                    end
                )
            end
        end
    end
)

