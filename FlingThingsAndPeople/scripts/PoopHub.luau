BuildWings = function()
    CleanupWings()
    local EquipmentSlot = GetToyFolders()
    local entityData = {}

    for _, char in ipairs(EquipmentSlot) do
        for _, projectile in ipairs(char:GetDescendants()) do
            if projectile:IsA("Model") and projectile.Name == grid.SelectedItem then
                table.insert(entityData, projectile)
            end
        end
    end

    if #entityData == 0 then
        return false
    end

    for k = 1, 2 do
        local result43 = {}

        for vertex = 1, grid.WingLength do
            local basePart = Instance.new("Part")
            basePart.CanCollide = false
            basePart.Anchored = true
            basePart.Transparency = 1
            basePart.Size = Vector3.new(4, 1, 4)
            basePart.Parent = rootGuiObject
            result43[#result43 + 1] = {Part = basePart}
        end

        local basePart = Instance.new("Part")
        basePart.CanCollide = false
        basePart.Anchored = true
        basePart.Transparency = 1
        basePart.Size = Vector3.new(4, 1, 4)
        basePart.Parent = rootGuiObject
        currentEvidence.Wings[#currentEvidence.Wings + 1] = {Handle = basePart, Segments = result43, Sync = {}, Reserved = nil}
    end

    for k, char in ipairs(entityData) do
        local elapsedTime = k <= #entityData / 2 and 1 or 2
        local HumanoidRootPart = char:FindFirstChild("SoundPart") or char:FindFirstChild("Handle") or char:FindFirstChildWhichIsA(
            "BasePart"
        )

        if HumanoidRootPart then
            for _, newPart in pairs(char:GetChildren()) do
                if newPart:IsA("BasePart") then
                    newPart.CanCollide = false
                end
            end

            local spawnPosition, otherVector = SetupPhysics(HumanoidRootPart)

            if not currentEvidence.Wings[elapsedTime].Reserved then
                currentEvidence.Wings[elapsedTime].Reserved = {BG = spawnPosition, BP = otherVector}
            else
                table.insert(currentEvidence.Wings[elapsedTime].Sync, {BG = spawnPosition, BP = otherVector})
            end
        end
    end

    return true
end

