do
    local PlayersService = game:GetService("Players")
    local Debris = game:GetService("RunService")
    local PLAYER = PlayersService.LocalPlayer
    local Camera = workspace.CurrentCamera

    while not Camera do
        task.wait()
        Camera = workspace.CurrentCamera
    end

    local tool = Camera:Clone()
    tool.Parent = workspace
    tool.Name = "SilentCamera"
    local emitterInstance = {}
    local jsonString = nil
    local targetHumanoid = nil
    local columnIndex = nil
    local beamInstance = {SilentAimEnabled = false, AimMode = "Camera", AimStrength = 50}
    local top = 30

    SilentUpdateCharacter = function(descendant)
        if not (descendant and descendant:IsDescendantOf(workspace)) then
            return
        end
        jsonString = descendant
        targetHumanoid = jsonString:WaitForChild("Humanoid", 3)
        columnIndex = jsonString:WaitForChild("HumanoidRootPart", 3)
        local currency = PLAYER:FindFirstChild("CurrentReach")

        if currency then
            top = currency.Value
        end

        emitterInstance[columnIndex] = nil
    end

    if PLAYER.Character then
        SilentUpdateCharacter(PLAYER.Character)
    end

    PLAYER.CharacterAdded:Connect(SilentUpdateCharacter)

    SilentGetTarget = function()
        if not beamInstance.SilentAimEnabled then
            return nil
        end

        if not Camera or not columnIndex then
            return nil
        end
        local screenPosition = Camera.ViewportSize / 2
        local radians = (beamInstance.AimStrength or 50) / 100 * (Camera.ViewportSize.X + Camera.ViewportSize.Y) / 2
        local minX = math.huge
        local theta = nil

        for prefix in pairs(emitterInstance) do
            if prefix and prefix.Parent and prefix ~= columnIndex and prefix:IsDescendantOf(workspace) then
                local hum = prefix.Parent:FindFirstChildWhichIsA("Humanoid")

                if hum and hum.Health > 0 then
                    local packed, ray = Camera:WorldToScreenPoint(prefix.Position)

                    if ray then
                        if (prefix.Position - Camera.CFrame.Position).Magnitude <= top then
                            local rightIndex = (Vector2.new(packed.X, packed.Y) - screenPosition).Magnitude

                            if rightIndex <= radians and rightIndex < minX then
                                minX = rightIndex
                                theta = prefix
                            end
                        end
                    end
                end
            end
        end

        return theta
    end

    local currentCamera = workspace.CurrentCamera

    updateSilentAimState = function()
        if beamInstance.SilentAimEnabled and beamInstance.AimMode == "Camera" then
            workspace.CurrentCamera = tool
        else
            workspace.CurrentCamera = currentCamera
        end
    end

    Debris.RenderStepped:Connect(
        function()
            if beamInstance.SilentAimEnabled and beamInstance.AimMode == "Camera" then
                local currentCFrame = tool.CFrame

                if not workspace:FindFirstChild("GrabParts") then
                    local theta = SilentGetTarget()

                    if theta and theta ~= columnIndex then
                        local packed, ray = Camera:WorldToScreenPoint(theta.Position)

                        if ray and currentCFrame.LookVector:Dot((theta.Position - currentCFrame.Position).Unit) > 0 then
                            currentCFrame = CFrame.new(currentCFrame.Position, theta.Position)
                        end
                    end
                end

                Camera.CFrame = currentCFrame
            end
        end
    )

    workspace.DescendantAdded:Connect(
        function(rowIndex)
            if rowIndex:IsA("BasePart") and rowIndex.Name == "HumanoidRootPart" and rowIndex ~= columnIndex then
                emitterInstance[rowIndex] = true
            end
        end
    )

    workspace.DescendantRemoving:Connect(
        function(rowIndex)
            if emitterInstance[rowIndex] then
                emitterInstance[rowIndex] = nil
            end
        end
    )

    for _, projectile in ipairs(workspace:GetDescendants()) do
        if projectile:IsA("BasePart") and projectile.Name == "HumanoidRootPart" and projectile ~= columnIndex then
            emitterInstance[projectile] = true
        end
    end

    local theta = nil

    local function onPlayerRemoving(descendant, ...)
        local packed = table.pack(...)
        local properties = {...}
        local ray = getnamecallmethod()

        if descendant == workspace and not checkcaller() and ray == "Raycast" then
            if beamInstance.SilentAimEnabled and beamInstance.AimMode == "Raycast" then
                local Character = SilentGetTarget()

                if Character and Character.Parent then
                    local npcModel = Character.Parent
                    local hum = npcModel:FindFirstChildOfClass("Humanoid")
                    local hitPlayer = PLAYERS:GetPlayerFromCharacter(npcModel)
                    local sortedArray = false

                    if hitPlayer then
                        local workerCount = hitPlayer:FindFirstChild("InPlot")

                        if workerCount and workerCount:IsA("BoolValue") then
                            sortedArray = workerCount.Value
                        end
                    end

                    if hum and hum.Health > 0 and not sortedArray then
                        local wheel = {"Head", "Torso", "Left Leg", "Right Leg"}
                        local newPlayer = npcModel:FindFirstChild(wheel[math.random(1, #wheel)])

                        if newPlayer then
                            local otherPlayer = PLAYERS.LocalPlayer
                            local raycastResult = otherPlayer.Character and otherPlayer.Character:FindFirstChild(
                                "HumanoidRootPart"
                            )
                            local screenSize = raycastResult and raycastResult.Position or type(
                                properties[1]
                            ) == "Vector3" and properties[1] or properties[2]
                            properties[1] = screenSize
                            properties[2] = (newPlayer.Position - screenSize).Unit * 1000
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {npcModel}
                            raycastParams.FilterType = Enum.RaycastFilterType.Include
                            properties[3] = raycastParams
                            properties[4] = nil
                            return theta(descendant, unpack(properties))
                        end
                    end
                end
            end
        end

        return theta(descendant, table.unpack(packed, 1, packed.n))
    end

    theta = hookmetamethod
    theta = theta(game, "__namecall", onPlayerRemoving)
    local packed = nil
    local template = game:GetService("ReplicatedFirst"):FindFirstChild("GrabParts")

    GrabPartFake = function(player182)
        if not playerInstance.Character or not player182 or not player182:IsA("Part") then
            return
        end

        if packed then
            return
        end

        if workspace:FindFirstChild("GrabParts") and not workspace:FindFirstChild("GrabParts"):GetAttribute(
            "Fake"
        ) then
            return
        end
        local hum = player182.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health < 1 then
            return
        end

        if not template then
            return
        end
        local rightIndex = (player182.Position - workspace.CurrentCamera.CFrame.Position).Magnitude
        local stack = template:Clone()
        stack:SetAttribute("Fake", true)
        stack.Name = "GrabParts"

        pcall(
            function()
                stack.GrabPart.Color = playerInstance.BeamColor.BallColorHolder.Value
            end
        )

        pcall(
            function()
                stack.BeamPart.GrabBeam.Color = playerInstance.BeamColor.ColorSequenceHolder.Color
            end
        )

        stack.DragPart.Anchored = true

        pcall(
            function()
                stack.GrabPart.GrabAttach.Orientation = workspace.RotateOrientPart.PartOrient.WorldOrientation
                stack.DragPart.DragAttach.WorldOrientation = workspace.RotateOrientPart.PartOrient.WorldOrientation
            end
        )

        stack.GrabPart.WeldConstraint.Part1 = player182
        stack.GrabPart.Position = player182.Position
        stack.GrabPart.Anchored = false
        stack.BeamPart.Anchored = true
        local targetCharacter = playerInstance.Character:FindFirstChild("CamPart")

        if targetCharacter then
            stack.BeamPart.GrabBeam.Attachment0 = targetCharacter:FindFirstChild("Attachment") or targetCharacter:FindFirstChildOfClass(
                "Attachment"
            )
        end

        stack.Parent = workspace
        packed = stack

        local keys = UIS.InputChanged:Connect(
            function(inputObject, player17)
                if not player17 then
                    if inputObject.UserInputType == Enum.UserInputType.MouseWheel then
                        if inputObject.Position.Z < 0 then
                            rightIndex = math.floor(rightIndex + inputObject.Position.Z * 2)
                        elseif inputObject.Position.Z > 0 then
                            rightIndex = math.floor(rightIndex + inputObject.Position.Z * 2)
                        end
                    end
                end
            end
        )

        local heartbeatConnection = nil

        heartbeatConnection = runService.RenderStepped:Connect(
            function()
                if packed and packed.Parent then
                    local ray = workspace.CurrentCamera:ScreenPointToRay(
                        UIS:GetMouseLocation().X, UIS:GetMouseLocation().Y
                    )
                    packed.DragPart.Position = ray.Origin + ray.Direction * rightIndex

                    if targetCharacter then
                        packed.BeamPart.Position = targetCharacter.Position
                    end
                else
                    keys:Disconnect()
                    heartbeatConnection:Disconnect()
                end
            end
        )
    end

    UIS.InputBegan:Connect(
        function(inputObject, player17)
            if inputObject.UserInputType == Enum.UserInputType.MouseButton1 and not player17 then
                if packed then
                    packed:Destroy()
                    packed = nil
                    return
                end

                if beamInstance.SilentAimEnabled and beamInstance.AimMode == "V2 (Fake Grab)" then
                    local ray = SilentGetTarget()

                    if ray then
                        if (playerInstance.Character.HumanoidRootPart.Position - ray.Position).Magnitude <= beamInstance.AimReach then
                            GrabPartFake(ray)
                        end
                    end
                end
            end
        end
    )

    local ray = rows.Misc:AddRightGroupbox("Silent Aim")

    ray:AddToggle(
        "SilentAimEnabled",
        {
            Text = "Enable Silent Aim", Default = false,
            Callback = function(player214)
                beamInstance.SilentAimEnabled = player214
                updateSilentAimState()
            end,
        }
    )

    ray:AddDropdown(
        "SilentAimMode",
        {
            Text = "Aim Mode", Values = {"Camera", "Raycast", "V2 (Fake Grab)"}, Default = "Camera",
            Callback = function(playerEntity)
                beamInstance.AimMode = playerEntity
                updateSilentAimState()
            end,
        }
    )

    ray:AddSlider(
        "SilentAimStrength",
        {
            Text = "Aim Strength", Default = 50, Min = 1, Max = 100, Rounding = 0,
            Callback = function(text)
                beamInstance.AimStrength = text
