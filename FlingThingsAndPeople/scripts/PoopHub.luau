setupOceanRainbow = function()
    if not grid.oceanRainbowEnabled then
        return
    end
    local result11 = rootGuiObject:FindFirstChild("Map")
    local left = result11 and result11:FindFirstChild("AlwaysHereTweenedObjects")
    left = left and left:FindFirstChild(
        "Ocean"
    )
    if not left then
        return function() end
    end
    local priorityQueue = {}
    currentEvidence.rainbowParts = {}

    for _, projectile in ipairs(left:GetDescendants()) do
        if projectile:IsA("BasePart") then
            table.insert(currentEvidence.rainbowParts, projectile)
            priorityQueue[projectile] = projectile.Color
        end
    end

    local connection = left.DescendantAdded:Connect(
        function(rowIndex)
            if rowIndex:IsA("BasePart") and grid.oceanRainbowEnabled then
                table.insert(currentEvidence.rainbowParts, rowIndex)
                priorityQueue[rowIndex] = rowIndex.Color
            end
        end
    )

    table.insert(currentEvidence.visualConnections, connection)
    local elapsedTime = 0

    local queue = runService.Heartbeat:Connect(
        function(alpha)
            if not grid.oceanRainbowEnabled then
                return
            end
            elapsedTime = (elapsedTime + alpha * 0.12) % 1
            local bestDistance = Color3.fromHSV(elapsedTime, 1, 1)

            for _, triangle in ipairs(currentEvidence.rainbowParts) do
                if triangle and triangle.Parent then
                    triangle.Color = bestDistance
                end
            end
        end
    )

    table.insert(currentEvidence.visualConnections, queue)

    return function()
        for prefix, char in pairs(priorityQueue) do
            if prefix and prefix.Parent then
                prefix.Color = char
            end
        end

        currentEvidence.rainbowParts = {}
    end
end

setupToyESPs = function()
    if not grid.shurikenESPEnabled and not grid.blobmanESPEnabled then
        return
    end

    if not currentEvidence.shurikenESPs then
        currentEvidence.shurikenESPs = {}
    end

    if not currentEvidence.blobmanESPs then
        currentEvidence.blobmanESPs = {}
    end

    addESPToPart = function(arguments, descendant)
        if arguments:FindFirstChild("ToyESPBox") then
            return nil
        end
        local billboardGui = Instance.new("BoxHandleAdornment")
        billboardGui.Name = "ToyESPBox"
        billboardGui.Adornee = arguments
        billboardGui.Size = arguments.Size
        billboardGui.AlwaysOnTop = true
        billboardGui.ZIndex = 10
        billboardGui.Transparency = descendant and (grid.blobmanESPTransparency or 0.3) or grid.shurikenESPTransparency or 0.3
        billboardGui.Color3 = descendant and (grid.blobmanESPSolidColor or Color3.new(0, 1, 0)) or grid.shurikenESPSolidColor or Color3.new(
            1, 0, 0
        )
        billboardGui.Parent = arguments
        return billboardGui
    end

    createESPForToy = function(descendant, point)
        local matrix = point and currentEvidence.blobmanESPs or currentEvidence.shurikenESPs
        if matrix[descendant] then
            return
        end
        local priorityQueue = {}

        for _, projectile in ipairs(descendant:GetDescendants()) do
            if projectile:IsA("BasePart") then
                local lower = addESPToPart(projectile, point)

                if lower then
                    table.insert(priorityQueue, lower)
                end
            end
        end

        if #priorityQueue > 0 then
            matrix[descendant] = priorityQueue
        end
    end

    removeESPFromToy = function(descendant, point)
        local matrix = point and currentEvidence.blobmanESPs or currentEvidence.shurikenESPs
        if not matrix[descendant] then
            return
        end

        for _, char in ipairs(matrix[descendant]) do
            if char then
                char:Destroy()
            end
        end

        matrix[descendant] = nil
    end

    findAndESPTos = function()
        local priorityQueue = {}
        local lines = {}

        scanFolder = function(descendant)
            for _, newPart in ipairs(descendant:GetChildren()) do
                if newPart:IsA("Model") then
                    if (newPart.Name == "AntiKick" or newPart.Name == "Shuriken" or newPart.Name == "ToyShuriken") and grid.shurikenESPEnabled then
                        priorityQueue[newPart] = true
                        createESPForToy(newPart, false)
                    elseif newPart.Name == "CreatureBlobman" and grid.blobmanESPEnabled then
                        lines[newPart] = true
                        createESPForToy(newPart, true)
                    end
                end
            end
        end

        for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
            local lower = rootGuiObject:FindFirstChild(playerObject.Name .. "SpawnedInToys")

            if lower then
                scanFolder(lower)
            end
        end

        local currentInstance = rootGuiObject:FindFirstChild("PlotItems")

        if currentInstance then
            for _, newPart in ipairs(currentInstance:GetChildren()) do
                for _, projectile in ipairs(newPart:GetDescendants()) do
                    if projectile:IsA("Model") then
                        if (projectile.Name == "AntiKick" or projectile.Name == "Shuriken" or projectile.Name == "ToyShuriken") and grid.shurikenESPEnabled then
                            priorityQueue[projectile] = true
                            createESPForToy(projectile, false)
                        elseif projectile.Name == "CreatureBlobman" and grid.blobmanESPEnabled then
                            lines[projectile] = true
                            createESPForToy(projectile, true)
                        end
                    end
                end
            end
        end

        for prefix in pairs(currentEvidence.shurikenESPs) do
            if not priorityQueue[prefix] or not prefix.Parent then
                removeESPFromToy(prefix, false)
            end
        end

        for prefix in pairs(currentEvidence.blobmanESPs) do
            if not lines[prefix] or not prefix.Parent then
                removeESPFromToy(prefix, true)
            end
        end
    end

    local connection = runService.Heartbeat:Connect(
        function()
            if grid.shurikenESPEnabled or grid.blobmanESPEnabled then
                findAndESPTos()
            end
        end
    )

    table.insert(currentEvidence.visualConnections, connection)
    local elapsedTime = 0

    local queue = runService.RenderStepped:Connect(
        function(alpha)
            elapsedTime = (elapsedTime + alpha * 60 * (grid.rainbowSpeedESP or 2)) % 360
            local bestDistance = Color3.fromHSV(elapsedTime / 360, 1, 1)

            if grid.shurikenESPEnabled then
                local index13 = grid.shurikenESPColorMode == "Rainbow" and bestDistance or grid.shurikenESPSolidColor
                local index14 = grid.shurikenESPTransparency or 0.3

                for _, players in pairs(currentEvidence.shurikenESPs) do
                    for _, char in ipairs(players) do
                        if char and char.Parent then
                            char.Color3 = index13
                            char.Transparency = index14
                        end
                    end
                end
            end

            if grid.blobmanESPEnabled then
                bestDistance = grid.blobmanESPColorMode == "Rainbow" and bestDistance or grid.blobmanESPSolidColor
                local visited = grid.blobmanESPTransparency or 0.3

                for _, child in pairs(currentEvidence.blobmanESPs) do
                    for _, char in ipairs(child) do
                        if char and char.Parent then
                            char.Color3 = bestDistance
                            char.Transparency = visited
                        end
                    end
                end
            end
        end
    )

    table.insert(currentEvidence.visualConnections, queue)

    return function()
        local lower = pairs
        local index15 = currentEvidence.shurikenESPs or {}

        for prefix in lower(index15) do
            removeESPFromToy(prefix, false)
        end

        local spawnPosition = pairs
        local matrix = currentEvidence.blobmanESPs or {}

        for prefix in spawnPosition(matrix) do
            removeESPFromToy(prefix, true)
        end

        currentEvidence.shurikenESPs = {}
        currentEvidence.blobmanESPs = {}
    end
end

