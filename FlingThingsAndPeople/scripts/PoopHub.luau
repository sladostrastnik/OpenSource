        )

        local seconds = result51:AddSlider(
            "LocalAuraRateMult_" .. modelTemplate,
            {
                Text = modelTemplate .. " Rate", Min = 0.1, Max = 10, Default = 1, Rounding = 1,
                Callback = function(descendant)
                    result32[modelTemplate] = descendant

                    if changed and type(openSet) == "table" and openSet[modelTemplate] then
                        enableAura()
                    end
                end,
            }
        )

        if snapshot.SetVisible then
            pcall(
                function()
                    snapshot:SetVisible(false)
                end
            )
        elseif snapshot.Container then
            snapshot.Container.Visible = false
        end

        if minutes.SetVisible then
            pcall(
                function()
                    minutes:SetVisible(false)
                end
            )
        elseif minutes.Container then
            minutes.Container.Visible = false
        end

        if seconds.SetVisible then
            pcall(
                function()
                    seconds:SetVisible(false)
                end
            )
        elseif seconds.Container then
            seconds.Container.Visible = false
        end

        bytes[modelTemplate] = {snapshot, minutes, seconds}
