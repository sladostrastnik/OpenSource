        local cost = false
        local currentCFrame = ray.CFrame
        local newPlayer = nil

        cleanup = function()
            if cost then
                pcall(
                    function()
                        runService:UnbindFromRenderStep("STClient")
                    end
                )

                cost = false
            end

            if heartbeatConnection then
                heartbeatConnection:Disconnect()
                heartbeatConnection = nil
            end

            if keys then
