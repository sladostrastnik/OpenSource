task.spawn(
    function()
        local packed = nil
        local nearestPlayer = nil

        while true do
            task.wait(beamInstance.InputLgDelay)

            if properties.AntiInputLag then
                refreshRemotes()
                local hitHumanoid = theta and theta:FindFirstChild("GrabEvents")

                if hitHumanoid and not nearestPlayer then
                    local dummyPart = hitHumanoid:FindFirstChild("EndGrabEarly")

                    if dummyPart then
                        dummyPart:Destroy()
                    end

                    nearestPlayer = Instance.new("RemoteEvent")
                    nearestPlayer.Name = "EndGrabEarly"
                    nearestPlayer.Parent = hitHumanoid
                end

                local ray, Character, newPlayer = emitterInstance.charp()
                packed = packed or emitterInstance.st(beamInstance.AntiInputType, CFrame.new(0, 1e20, 0))

                if packed and packed.Parent then
                    local LocalPlayer = packed:WaitForChild("HoldPart", 2)
                    local isPinned = LocalPlayer and LocalPlayer:WaitForChild(
                        "HoldItemRemoteFunction", 2
                    )
                    local constraint = isPinned and LocalPlayer:WaitForChild(
                        "DropItemRemoteFunction", 2
                    )
                    local ballSocket = LocalPlayer and LocalPlayer:FindFirstChild("RigidConstraint")

                    for _, projectile in ipairs(packed:GetDescendants()) do
                        if projectile:IsA("BasePart") then
                            projectile.CanCollide = false
                            if projectile:IsA("MeshPart") or projectile.Name == "Part" then
                                projectile.Transparency = beamInstance.AILTransparency
                                continue
                            end
                            continue
                        end

                        if projectile:IsA("Decal") then
                            projectile.Transparency = beamInstance.AILTransparency
                        end
                    end

                    if ray and newPlayer and newPlayer.Health > 0 and LocalPlayer and isPinned and constraint then
                        task.spawn(
                            function()
                                pcall(
                                    function()
                                        local steer = Vector3.new
                                        constraint:InvokeServer(
                                            packed, CFrame.new(0, 1e20, 0), steer()
                                        )
                                    end
                                )
                            end
                        )

                        task.spawn(
                            function()
                                pcall(
                                    function()
                                        isPinned:InvokeServer(packed, ray)
                                    end
                                )
                            end
                        )

                        if ballSocket then
                            local result10 = ray:FindFirstChild("Left Arm")
                            local result25 = ray:FindFirstChild("Right Arm")
                            result10 = result10 and result10:FindFirstChild("LeftGripAttachment")
                            result25 = result25 and result25:FindFirstChild("RightGripAttachment")
                            local smallest = ballSocket.Attachment1

                            if smallest and smallest ~= result10 and smallest ~= result25 then
                                emitterInstance.dt(packed)
                                packed = nil
                                continue
                            end

                            continue
                        end

                        continue
                    end

                    emitterInstance.dt(packed)
                    packed = nil
                end
            else
                if packed then
                    emitterInstance.dt(packed)
                    packed = nil
                end

                if nearestPlayer then
                    nearestPlayer:Destroy()
                    nearestPlayer = nil
                end
