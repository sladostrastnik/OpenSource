        end

        return nil, nil
    end

    ResolveByName = function(descendant)
        local content = descendant.Name:lower()

        for _, definition in ipairs(openSet) do
            for _, firstElement in ipairs(definition.keywords) do
                if content:find(firstElement) then
                    return definition.id, "name:" .. firstElement
                end
            end
        end

        return nil, nil
    end

    Resolve = function(descendant)
        local spawnPosition, otherVector = ResolveCornerWedge(descendant)
        if spawnPosition then
            return spawnPosition, otherVector
        end
        local rotationAngle, randomYaw = ResolveByPathColor(descendant)
        if rotationAngle then
            return rotationAngle, randomYaw
        end
        local refreshButton, existingPlayer = ResolveByColorMaterial(descendant)
        if refreshButton then
            return refreshButton, existingPlayer
        end
        local userId, modelName = ResolveByParentModel(descendant)
        if userId then
            return userId, modelName
        end
        local result50, result51 = ResolveByName(descendant)
        if result50 then
            return result50, result51
        end
        return nil, nil
    end

    ShouldSkipMCPart = function(descendant)
        local content = GetFullPath(descendant):lower()

        if descendant.Name == "SNOWPART" then
            local npcModel = descendant.Parent
            if npcModel and npcModel:IsA("Model") and npcModel.Name == "_PoophubSnowSystem" then
                return true
            end
        end

        for _, definition in ipairs({"sky", "skybox", "cloud", "sun", "moon", "star"}) do
            if content:find(definition, 1, true) then
                return true
            end
        end

        return false
    end

    PasteFace = function(Lighting, value3, modulus)
        local decal = Instance.new("Texture")
        decal.Texture = modulus
        decal.Face = value3
        decal.StudsPerTileU = grid.mcTileSize
        decal.StudsPerTileV = grid.mcTileSize
        decal.Parent = Lighting
    end

    ApplyAllFaces = function(descendant, point)
        for _, definition in ipairs(
            {
                Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back,
                Enum.NormalId.Left, Enum.NormalId.Right,
            }
        ) do
            PasteFace(descendant, definition, point)
        end
    end

    ApplyMCTextures = function()
        local reportLines = {}
        local top = 0
        local screenPosition = 0
        local radians = 0

        for _, projectile in ipairs(workspace:GetDescendants()) do
            if projectile:IsA("BasePart") and not projectile:IsA("Terrain") then
                top += 1

                if ShouldSkipMCPart(projectile) then
                    screenPosition += 1
                    TexLog(
                        string.format(
                            "SKIP [sky/snow] 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ%s",
                            projectile:GetFullName()
                        )
                    )
                else
                    local spawnPosition, otherVector = Resolve(projectile)

                    if spawnPosition == rows.Snow then
                        screenPosition += 1
                        TexLog(
                            string.format(
                                "SKIP [snow] 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ%s",
                                projectile:GetFullName()
                            )
                        )
                    elseif spawnPosition then
                        if originalTable[projectile] == nil then
                            local result40 = {}

                            for _, newPart in ipairs(projectile:GetChildren()) do
                                if newPart:IsA("Texture") or newPart:IsA("Decal") then
                                    table.insert(result40, newPart:Clone())
                                    newPart:Destroy()
                                end
                            end

                            if #result40 == 0 then
                                result40 = {"empty"}
                            end

                            originalTable[projectile] = result40
                        else
                            for _, newPart in ipairs(projectile:GetChildren()) do
                                if newPart:IsA("Texture") or newPart:IsA("Decal") then
                                    newPart:Destroy()
                                end
                            end
                        end

                        ApplyAllFaces(projectile, spawnPosition)
                        radians += 1
                        reportLines[otherVector] = (reportLines[otherVector] or 0) + 1
                        TexLog(
                            string.format(
                                "HIT [%s] 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ%s", otherVector,
                                projectile:GetFullName()
                            )
                        )
                    else
                        screenPosition += 1
                        TexLog(
                            string.format(
                                "SKIP 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ%s",
                                projectile:GetFullName()
                            )
                        )
                    end
                end
            end
        end

        TexLog(string.format("Scanned:%d Applied:%d Skipped:%d", top, radians, screenPosition))
        return radians, screenPosition
    end

    RestoreOriginalTextures = function()
        local top = 0

        for prefix, neighbors in pairs(originalTable) do
            if prefix and prefix.Parent then
                for _, newPart in ipairs(prefix:GetChildren()) do
                    if newPart:IsA("Texture") or newPart:IsA("Decal") then
                        newPart:Destroy()
                    end
                end

                for _, definition in ipairs(neighbors) do
                    if definition ~= "empty" then
                        definition:Clone().Parent = prefix
                    end
                end

                top += 1
            end
        end

        table.clear(originalTable)
        TexLog(string.format("Restored %d parts", top))
    end
end

