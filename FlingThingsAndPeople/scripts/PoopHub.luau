    _G.updateBlackholeImage = function(descendant)
        local targetName = descendant:match("^%s*(.-)%s*$")
        if not targetName or targetName == "" then
            return
        end

        if string.find(targetName, "rbxassetid://") then
            characters = targetName
            _G.updateAllBlackholes()
        elseif string.find(targetName, "http") then
            task.spawn(
                function()
                    local parsed, sourceString = pcall(
                        function()
                            return game:HttpGet(targetName)
                        end
                    )

                    if parsed and sourceString and #sourceString > 0 then
                        local sortedArray = sourceString:sub(1, 4) == "\137PNG" or sourceString:sub(1, 2) == "\255\216" or sourceString:sub(
                            1, 3
                        ) == "GIF"
                        local cost = false

                        if sortedArray then
                            cost = true
                        end

                        if not cost then
                            if key and key.Notify then
                                _NOTIFY(
                                    "Invalid image! Ensure URL points directly to an image file.", 4
                                )
                            end

                            return
                        end

                        pcall(
                            function()
                                local content = targetName:gsub("[^%w]", "")

                                if #content > 40 then
                                    content = content:sub(#content - 40)
                                end

                                local fileName = "PoopHub/custom_blackhole_" .. content .. "_" .. tostring(
                                    math.random(10000, 99999)
                                ) .. ".png"
                                writefile(fileName, sourceString)

                                local decodeSuccess, bestAction = pcall(
                                    function()
                                        return getcustomasset(fileName)
                                    end
                                )

                                if decodeSuccess and bestAction then
                                    characters = bestAction
                                else
                                    characters = "rbxassetid://117677503754205"
                                end

                                _G.updateAllBlackholes()

                                if key and key.Notify then
                                    _NOTIFY("Success! Blackhole Image Applied.", 3)
                                end
                            end
                        )
                    elseif key and key.Notify then
                        _NOTIFY("Failed to download image from URL", 3)
                    end
                end
            )
        end
    end

    if grid.customBlackholeImage and grid.customBlackholeImage ~= "" then
        _G.updateBlackholeImage(grid.customBlackholeImage)
    end

    applyVisualSettings = function(descendant)
        if grid.customBlackholeEnabled then
            if descendant.large then
                descendant.large.Image = characters
                descendant.large.ImageColor3 = Color3.new(1, 1, 1)
                descendant.large.ImageTransparency = 0
                descendant.large.Visible = true

                pcall(
                    function()
                        descendant.large.ResampleMode = Enum.ResamplerMode.Pixelated
                    end
                )
            end

            if descendant.small then
                descendant.small.Visible = false
            end

            if descendant.hole then
                descendant.hole.Transparency = 1
            end
        else
            if descendant.large then
                descendant.large.Image = descendant.originalLargeImage
                descendant.large.ImageColor3 = descendant.originalLargeImageColor3 or Color3.new(1, 1, 1)
                descendant.large.ImageTransparency = descendant.originalLargeImageTrans or 0
            end

            if descendant.small then
                descendant.small.Visible = descendant.originalSmallVisible
            end

            if descendant.hole then
                descendant.hole.Transparency = descendant.originalHoleTransparency
            end
        end
