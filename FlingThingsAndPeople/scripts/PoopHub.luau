                if not moduleFolder then
                    changed = true
                    return
                end

                if not descendant.Character or not descendant.Character:FindFirstChild("Head") then
                    changed = true
                    return
                end
                explosion = descendant.Character:FindFirstChild("Head")
                cost = DoSticky(moduleFolder, explosion)
