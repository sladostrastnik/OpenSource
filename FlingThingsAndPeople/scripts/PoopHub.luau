                else
                    destroyHat()
                end
            end,
        }
    ):AddColorPicker(
        "UmbrellaMeshColor",
        {
            Default = Color3.fromRGB(255, 255, 255), Title = "Umbrella Color",
            Callback = function(output)
                bestDistance = output

                if segmentPart then
                    pcall(
                        function()
                            segmentPart.Color = output
                        end
                    )
                end
            end,
        }
    )

    array:AddToggle(
        "UmbrellaMeshRainbow",
        {
            Text = "Rainbow Umbrella", Default = false,
            Callback = function(descendant)
                cost = descendant

                if sortedArray then
                    destroyHat()
                    buildHat()
                end
            end,
        }
    )

    array:AddSlider(
        "UmbrellaMeshTrans",
        {
            Text = "Umbrella Transparency", Min = 0, Max = 100, Default = 30, Rounding = 0,
            Callback = function(descendant)
                average = descendant / 100

                if segmentPart then
                    pcall(
                        function()
                            segmentPart.Transparency = average
                        end
                    )
                end
            end,
        }
    )

    array:AddSlider(
        "UmbrellaMeshSize",
        {
            Text = "Umbrella Size", Min = 0.5, Max = 10, Default = 2.4, Rounding = 1,
            Callback = function(descendant)
                top = descendant

                if segmentPart and segmentPart:FindFirstChildOfClass("SpecialMesh") then
                    pcall(
                        function()
                            segmentPart:FindFirstChildOfClass("SpecialMesh").Scale = Vector3.new(
                                descendant, descendant * 0.66666666666666674, descendant
                            )
                        end
                    )
                end
            end,
        }
    )

    array:AddSlider(
        "UmbrellaMeshHeight",
        {
            Text = "Umbrella Height", Min = -10, Max = 10, Default = 1.1, Rounding = 1,
            Callback = function(descendant)
                screenPosition = descendant

                if sortedArray then
                    destroyHat()
                    buildHat()
                end
            end,
        }
    )

    array:AddDropdown(
        "UmbrellaMeshMaterial",
        {
            Values = {
                "Neon", "ForceField", "Plastic", "SmoothPlastic", "Glass", "Ice", "Wood", "Metal",
                "Foil",
            }, Default = "Neon", Multi = false, Text = "Umbrella Material",
            Callback = function(descendant)
                cell = Enum.Material[descendant]

                if segmentPart then
                    pcall(
                        function()
                            segmentPart.Material = cell
                        end
                    )
                end
            end,
        }
    )

    result51:AddToggle(
        "LocalAuraToggle",
        {
            Text = "Local Aura", Default = false,
            Callback = function(descendant)
                changed = descendant

                if descendant then
                    if #emitterInstance == 0 then
                        updateAuraLogic()
                    end

                    enableAura()
                else
                    disableAura()
                end
            end,
        }
    )

    local sorted = {}

    for prefix in pairs(wheel) do
        table.insert(sorted, prefix)
    end

    table.sort(sorted)
    local voteCount = {}
    local result32 = {}
    local bytes = {}

    updateDynamicUIVisibility = function()
        for prefix, modelTemplate in pairs(bytes) do
            local isFiveM = openSet and type(openSet) == "table" and openSet[prefix] == true

            for _, pointIndex in ipairs(modelTemplate) do
                if pointIndex.SetVisible then
                    pcall(
                        function()
                            pointIndex:SetVisible(isFiveM)
                        end
                    )
                elseif pointIndex.Container then
                    pointIndex.Container.Visible = isFiveM
                end
            end
        end
    end

