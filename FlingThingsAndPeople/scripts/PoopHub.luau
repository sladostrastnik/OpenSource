    gkaBlobGrab = function(descendant, point)
        if not descendant or not descendant.Parent then
            return
        end

        if not point or not point.Parent then
            return
        end

        for _, definition in ipairs({"Left", "Right"}) do
            local otherVector = descendant:FindFirstChild(definition .. "Detector")
            local rotationAngle = otherVector and otherVector:FindFirstChild(definition .. "Weld")
            local remoteEvent = descendant:FindFirstChild("BlobmanSeatAndOwnerScript")
            local intersect = remoteEvent and remoteEvent:FindFirstChild(
                "CreatureGrab"
            )

            if otherVector and rotationAngle and intersect then
                pcall(
                    function()
                        intersect:FireServer(otherVector, point, rotationAngle)
                    end
                )
            end
        end
    end

    gkaStop = function()
        sortedArray = false

        if keys then
            pcall(
                function()
                    keys:Disconnect()
                end
            )

            keys = nil
        end

        batch = {}
        top = 0

        pcall(
            function()
                _G.kt_stopLineLag()
            end
        )

        _NOTIFY("GatherKickAll: Stopped.", 2)
    end

    _G.gka_stop = gkaStop

    gkaExecute = function()
        if sortedArray then
            _NOTIFY("GatherKickAll: Already running!", 2)
            return
        end
        sortedArray = true

        task.spawn(
            function()
                local characterModel = playerInstance.Character or playerInstance.CharacterAdded:Wait()
                local columnIndex = characterModel:WaitForChild("HumanoidRootPart", 10)
                if not columnIndex then
                    gkaStop()
                    return
                end
                local edgeList = {}

                for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
                    if playerObject ~= playerInstance then
                        local decoded, sampleText = pcall(
                            function()
                                return playerInstance:IsFriendsWith(playerObject.UserId)
                            end
                        )

                        if not (grid.kickExcludeFriends and decoded and sampleText) then
                            local playerCharacter = playerObject.Character
                            playerCharacter = playerCharacter and playerCharacter:FindFirstChild(
                                "HumanoidRootPart"
                            )

                            if playerCharacter then
                                table.insert(edgeList, {player = playerObject, hrp = playerCharacter})
                            end
                        end
                    end
                end

                if #edgeList == 0 then
                    _NOTIFY("GatherKickAll: No targets!", 3)
