isPlayerAlive = function(descendant)
    local characterModel = descendant.Character
    if not characterModel then
        return false
    end
    local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")
    return targetHumanoid and targetHumanoid.Health > 0
end

isPlayerInPlot = function(descendant)
    return descendant:FindFirstChild("InPlot") and descendant.InPlot.Value
end

shouldProcessAuraPlayer = function(descendant)
    if descendant == playerInstance then
        return false
    end

    if grid.kickAuraFriendWhitelist and playerInstance:IsFriendsWith(descendant.UserId) then
        return false
    end

    if isPlayerInPlot(descendant) then
        return false
    end

    if not isPlayerAlive(descendant) then
        return false
    end
    local theta = currentEvidence.kickAuraCooldowns[descendant.UserId]
    local sortedArray

    if theta then
        local index7 = grid.kickAuraCooldown
        sortedArray = os.clock() - theta < index7
    else
        sortedArray = theta
    end

    if sortedArray then
        return false
    end
    return true
end

runAuraKick = function(descendant, point, object)
    local characterModel = playerInstance.Character
    local columnIndex

    if characterModel then
        columnIndex = characterModel:FindFirstChild("HumanoidRootPart") or characterModel:FindFirstChild(
            "Torso"
        )
    else
        columnIndex = characterModel
    end

    if not columnIndex then
        return
    end
    local AppendEntriesEvent = root.GrabEvents.SetNetworkOwner
    local response = root.GrabEvents.DestroyGrabLine
    local intersect = descendant.BlobmanSeatAndOwnerScript.CreatureGrab
    local theta = descendant:FindFirstChild(object .. "Detector")
    local packed = theta and theta:FindFirstChild(object .. "Weld")

    grabPart = function(v)
        if theta and packed then
            pcall(
                function()
                    intersect:FireServer(theta, v, packed)
                end
            )
        end
    end

    ungrabPart = function(v)
        pcall(
            function()
                response:FireServer(v)
            end
        )
    end

    grabPart(columnIndex)
    task.wait(0.076923076923076927)

    pcall(
        function()
            AppendEntriesEvent:FireServer(point, columnIndex.CFrame)
        end
    )

    task.wait()
    point.CFrame = point.CFrame + Vector3.new(0, 11, 0)
    ungrabPart(point)
    task.wait(0.076923076923076927)
    grabPart(point)
end

_G.stopKickAura = function()
    if currentEvidence.kickAuraConnection then
        currentEvidence.kickAuraConnection:Disconnect()
        currentEvidence.kickAuraConnection = nil
    end

    if currentEvidence.forceDisabledConnection then
        currentEvidence.forceDisabledConnection:Disconnect()
        currentEvidence.forceDisabledConnection = nil
    end

    currentEvidence.kickAuraCooldowns = {}
    currentEvidence.forceDisabledPlayers = {}
    destroyAuraBlobman()
end

_G.startKickAura = function()
    _G.stopKickAura()

    currentEvidence.forceDisabledConnection = runService.Heartbeat:Connect(
        function()
            if not (grid.blobmanAuraEnabled and grid.blobmanAuraMode == "Kick Aura") then
                return
            end

            for prefix in pairs(currentEvidence.forceDisabledPlayers) do
                if prefix.Character then
                    removeAllForces(prefix.Character)
                end
            end
        end
    )

    currentEvidence.kickAuraConnection = runService.Heartbeat:Connect(
        function()
            if not (grid.blobmanAuraEnabled and grid.blobmanAuraMode == "Kick Aura") then
                return
            end
            ensureAuraBlobmanAndSit()
            local targetUserId = currentEvidence.kickAuraBlobman or getAuraBlobman()
            if not targetUserId then
                return
            end
            removeAttachPlayer(targetUserId)
            local characterModel = playerInstance.Character

            if characterModel then
                characterModel = characterModel:FindFirstChild("HumanoidRootPart") or characterModel:FindFirstChild(
                    "Torso"
                )
            end

            if not characterModel then
                return
            end

            for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
                if shouldProcessAuraPlayer(playerObject) then
                    local playerCharacter = playerObject.Character
                    local columnIndex = playerCharacter and (playerCharacter:FindFirstChild(
                        "HumanoidRootPart"
                    ) or playerCharacter:FindFirstChild("Torso"))

                    if columnIndex and (columnIndex.Position - characterModel.Position).Magnitude <= grid.kickAuraRange then
                        runAuraKick(targetUserId, columnIndex, "Left")
                        currentEvidence.forceDisabledPlayers[playerObject] = true
                        removeAllForces(playerCharacter)
                        currentEvidence.kickAuraCooldowns[playerObject.UserId] = os.clock()
                        break
                    end
                end
            end
        end
    )
end

