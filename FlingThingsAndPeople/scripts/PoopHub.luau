updateBlobmanAuraMode = function()
    grid.blobmanAuraRunning = grid.blobmanAuraEnabled

    if not grid.blobmanAuraEnabled or grid.blobmanAuraMode ~= "Kick Aura" then
        if _G.stopKickAura then
            _G.stopKickAura()
        end
    end

    if not grid.blobmanAuraEnabled then
        return
    end
    local direction = grid.blobmanAuraMode

    local function onPlayerRemoving()
        return grid.blobmanAuraRunning
    end

    if direction == "Kill Aura" then
        task.spawn(
            function()
                runAura(true, onPlayerRemoving)
            end
        )
    elseif direction == "Destroy Aura" then
        task.spawn(
            function()
                runAura(false, onPlayerRemoving)
            end
        )
    elseif direction == "Speed/Jump Control" then
        task.spawn(
            function()
                runSpeedJumpAura(onPlayerRemoving)
            end
        )
    elseif direction == "TP Spam" then
        task.spawn(
            function()
                runTPSpamAura(onPlayerRemoving)
            end
        )
    elseif direction == "Kick Aura" then
        task.spawn(
            function()
                if _G.startKickAura then
                    _G.startKickAura()
                end
            end
        )
    end
end

updateBlobmanAllMode = function()
    grid.blobmanAllRunning = grid.blobmanAllEnabled
    if not grid.blobmanAllEnabled then
        return
    end
    local start = grid.blobmanAllMode

