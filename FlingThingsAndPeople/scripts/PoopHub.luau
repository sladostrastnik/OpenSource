                        ElevatorStatusFunction:InvokeServer(descendant, top, Vector3.zero)
                    end
                )
            end
        )

        local previousTime = tick()

        while true do
            task.wait()
            if not (ray or tick() - previousTime > 3) then
                continue
            end
            break
        end

        keys:Disconnect()
        return ray
