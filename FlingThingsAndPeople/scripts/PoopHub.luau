    FontLog = function(descendant)
        if grid.mcFontDebug then
            print("[MCFont] " .. tostring(descendant))
        end
    end

    ApplyFontObj = function(descendant)
        for _, definition in ipairs(rows) do
            if descendant:IsA(definition) then
                if openSet[descendant] == nil then
                    openSet[descendant] = descendant.FontFace
                end

                pcall(
                    function()
                        descendant.FontFace = Font.new("rbxassetid://12187371840")
                    end
                )

                FontLog("Applied 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ" .. descendant:GetFullName())
                return
            end
        end
    end

    ApplyFontToRoot = function(descendant)
        local top = 0

        pcall(
            function()
                for _, projectile in ipairs(descendant:GetDescendants()) do
                    for _, definition in ipairs(rows) do
                        if projectile:IsA(definition) then
                            if openSet[projectile] == nil then
                                openSet[projectile] = projectile.FontFace
                            end

                            pcall(
                                function()
                                    projectile.FontFace = Font.new("rbxassetid://12187371840")
                                end
                            )

                            top += 1
                            FontLog(
                                "Applied 鬩包ｽｶ驗呻ｽｫ郢晢ｽｻ" .. projectile:GetFullName(
                                )
                            )
                            break
                        end
                    end
                end
            end
        )

        return top
    end

    ApplyFontAll = function()
        local top = 0

        if HUMANOID then
            top = 0 + ApplyFontToRoot(HUMANOID)
        end

        FontLog(string.format("Total applied: %d", top))
        return top
    end

    RestoreOriginalFonts = function()
        local top = 0

        for prefix, definition in pairs(openSet) do
            if prefix and prefix.Parent then
                pcall(
                    function()
                        prefix.FontFace = definition
                    end
                )

                top += 1
            end
        end

        table.clear(openSet)
        FontLog(string.format("Restored %d elements", top))
    end

    StartFontAutoApply = function()
        for _, definition in ipairs(emitterInstance) do
            definition:Disconnect()
        end

        emitterInstance = {}

        watch = function(descendant)
            pcall(
                function()
                    local keys = descendant.DescendantAdded:Connect(
                        function(rowIndex)
                            task.defer(
                                function()
                                    if grid.mcFontEnabled then
                                        ApplyFontObj(rowIndex)
                                    end
                                end
                            )
                        end
                    )

                    table.insert(emitterInstance, keys)
                end
            )
        end

        if HUMANOID then
            watch(HUMANOID)
        end

        FontLog("Auto-apply started.")
    end

    StopFontAutoApply = function()
        for _, definition in ipairs(emitterInstance) do
            definition:Disconnect()
        end

        emitterInstance = {}
        FontLog("Auto-apply stopped.")
    end
end

