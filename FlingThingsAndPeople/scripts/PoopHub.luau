                        if windowInstance and grid.noksGradientFill and grid.noksGradientRotate then
                            windowInstance.Rotation = (otherVector.BoxFillGradRotation + grid.noksRotateSpeed * screenPosition) % 360
                        end
                    end

                    if otherVector.CloneNameLabel then
                        local surfaceAppearance = otherVector.CloneNameLabel:FindFirstChildOfClass("UIGradient")

                        if surfaceAppearance and grid.noksNameGradient then
                            local finish = tick()
                            local difference = finish - otherVector.LastUpdate
                            otherVector.LastUpdate = finish
                            otherVector.NameGradientOffset = otherVector.NameGradientOffset + grid.noksNameScrollSpeed / 10 * difference * otherVector.NameGradientDirection

                            if otherVector.NameGradientOffset >= 1 then
