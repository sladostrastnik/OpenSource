    toyGetOffsetCFrame = function(descendant)
        local nearestDistance = CFrame.Angles
        local radian = math.rad
        local heading = descendant.rz
        return CFrame.new(descendant.x, descendant.y + elapsedTime, descendant.z) * nearestDistance(
            math.rad(descendant.rx), math.rad(descendant.ry), radian(heading)
        )
    end

    toyGetShieldMainPart = function(descendant)
        return descendant:FindFirstChild("PyramidOctagon") or descendant:FindFirstChild("SoundPart") or descendant:FindFirstChild(
            "Handle"
        ) or descendant:FindFirstChildWhichIsA("BasePart")
    end

    toyClaimAndMove = function(descendant, actionName)
        pcall(
            function()
                AntiCheatEvent:FireServer(descendant, descendant.CFrame)
                task.wait(0.05)
                descendant.CFrame = actionName
                descendant.AssemblyLinearVelocity = Vector3.zero
                descendant.AssemblyAngularVelocity = Vector3.zero
                AntiCheatEvent:FireServer(descendant, actionName)
            end
        )
    end

