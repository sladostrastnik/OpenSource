runService.RenderStepped:Connect(
    function(alpha)
        if grid.WingsActive and #currentEvidence.Wings > 0 then
            pcall(
                function()
                    local characterModel = playerInstance.Character
                    local marker

                    if characterModel then
                        marker = characterModel:FindFirstChild("Torso") or characterModel:FindFirstChild(
                            "UpperTorso"
                        )
                    else
                        marker = characterModel
                    end

                    if marker and characterModel:FindFirstChild("HumanoidRootPart") then
                        grid.TimeCounter = grid.TimeCounter + alpha * (grid.WingSpeed + characterModel.HumanoidRootPart.Velocity.Magnitude / 40)

                        for k, segment in ipairs(currentEvidence.Wings) do
                            local top = k == 1 and 1 or -1
                            segment.Handle.CFrame = marker.CFrame * result41.Offsets[k] * CFrame.Angles(
                                0, 0,
                                math.sin(grid.TimeCounter) * math.rad(
                                    grid.WingAngle + characterModel.HumanoidRootPart.Velocity.Magnitude / 4
                                ) * top
                            )

                            if segment.Reserved then
                                segment.Reserved.BP.Position = segment.Handle.Position
                                segment.Reserved.BG.CFrame = segment.Handle.CFrame * CFrame.Angles(
                                    1.5707963267948966, 0, 1.5707963267948966
                                )
                            end

                            for vertex, zone in ipairs(segment.Segments) do
                                zone.Part.CFrame = zone.Part.CFrame:Lerp(
                                    (vertex == 1 and segment.Handle.CFrame or segment.Segments[vertex - 1].Part.CFrame) * result41.Offsets[k],
                                    0.5
                                )

                                if segment.Sync[vertex] then
                                    segment.Sync[vertex].BP.Position = zone.Part.Position
                                    segment.Sync[vertex].BG.CFrame = zone.Part.CFrame * CFrame.Angles(
                                        1.5707963267948966, 0, 1.5707963267948966
                                    )
                                end
                            end
                        end
                    end
                end
            )
        end

        if grid.headEnabled and not grid.danceEnabled then
            pcall(
                function()
                    local theta = getChar()
                    local packed = GetRepresentativePart(theta, "HumanoidRootPart")
                    local ray = GetRepresentativePart(theta, "Head")

                    if packed and ray then
                        _G.spinAngle = _G.spinAngle + grid.speed * alpha
                        local screenSize = packed.Position
                        local sphereRadius = grid.radius
                        local top = screenSize.Y + grid.height
                        local blurRadius = grid.radius
                        ray.CFrame = CFrame.new(
                            Vector3.new(
                                screenSize.X + math.cos(_G.spinAngle) * sphereRadius, top,
                                screenSize.Z + math.sin(_G.spinAngle) * blurRadius
                            )
                        ) * (ray.CFrame - ray.CFrame.p)
                    end
                end
            )
        end

        if grid.characterSpinEnabled then
            pcall(
                function()
                    local columnIndex = getChar()
                    columnIndex = columnIndex and columnIndex:FindFirstChild(
                        "HumanoidRootPart"
                    )

                    if columnIndex then
                        columnIndex.CFrame = columnIndex.CFrame * CFrame.Angles(
                            0, math.rad(grid.characterSpinSpeed * 100 * alpha), 0
                        )
                    end
                end
            )
        end
    end
)

