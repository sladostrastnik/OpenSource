            elseif Fun.angryState == "launch" and Fun.angryStateTime >= 1.5 then
                Fun.angryState = "shock"
                Fun.angryStateTime = 0
            elseif Fun.angryState == "shock" and Fun.angryStateTime >= 1 then
                Fun.angryState = "falling"
                Fun.angryStateTime = 0
            elseif Fun.angryState == "falling" and Fun.angryStateTime >= 1.5 then
                Fun.angryState = "catch"
                Fun.angryStateTime = 0
            elseif Fun.angryState == "catch" and Fun.angryStateTime >= 0.5 then
                Fun.angryState = "angry"
                Fun.angryStateTime = 0
                Fun.angryHeadStartPos = nil
                Fun.angryHeadVelocity = nil
            end

            torsoOffset = nil
            headOffset = nil
            leftArmOffset = nil
            rightArmOffset = nil
            leftLegOffset = nil
            rightLegOffset = nil

            if Fun.angryState == "angry" then
                shakeX = math.sin(Fun.angryStateTime * 30) * 0.06
                shakeY = math.sin(Fun.angryStateTime * 35 + 1) * 0.05
                shakeZ = math.sin(Fun.angryStateTime * 28 + 2) * 0.05
                local nearestDistance = CFrame.Angles
                local radian = math.rad
                local elapsedTime = shakeY * 15
                torsoOffset = CFrame.new(shakeX, shakeY, shakeZ) * nearestDistance(
                    math.rad(shakeX * 20), math.rad(shakeZ * 20), radian(elapsedTime)
                )
                local Graph = CFrame.Angles
                local rad = math.rad
                local columnCount = shakeY * 20
                headOffset = CFrame.new(shakeX * 1.2, 1.5 + shakeY * 1.2, shakeZ * 1.2) * Graph(
                    math.rad(-5 + shakeX * 30), math.rad(shakeZ * 25), rad(columnCount)
                )
                local deltaZ = CFrame.Angles
                local radX = math.rad
                local offsetZ = 15 + shakeY * 20
                leftArmOffset = CFrame.new(-2, 1, -1.5 + shakeZ) * deltaZ(
                    math.rad(10 + shakeX * 15), 0, radX(offsetZ)
                ) * CFrame.new(0, -1, 0)
                local safeExecute = CFrame.Angles
                local radZ = math.rad
                local index9 = -15 - shakeY * 20
                rightArmOffset = CFrame.new(2, 1, -1.5 + shakeZ) * safeExecute(
                    math.rad(10 + shakeX * 15), 0, radZ(index9)
                ) * CFrame.new(0, -1, 0)
                local onPlayerAdded = CFrame.Angles
                leftLegOffset = CFrame.new(-0.9 + shakeX * 0.5, -2 + shakeY * 0.3, shakeZ * 0.3) * onPlayerAdded(
                    math.rad(shakeX * 8), -0.26179938779914941, 0
                )
                local deepCopy = CFrame.Angles
                rightLegOffset = CFrame.new(0.9 + shakeX * 0.5, -2 + shakeY * 0.3, -shakeZ * 0.3) * deepCopy(
                    math.rad(shakeX * 8), 0.26179938779914941, 0
                )
            elseif Fun.angryState == "launch" then
                angryT = Fun.angryStateTime
                gravity = Vector3.new(0, -workspace.Gravity, 0)
                torsoOffset = CFrame.new(0, 0, 0)

                if head and Fun.angryHeadStartPos then
                    headPos = Fun.angryHeadStartPos + Fun.angryHeadVelocity * angryT + 0.5 * gravity * angryT * angryT
                    head.CFrame = CFrame.new(headPos) * CFrame.Angles(
                        angryT * 10, angryT * 8, angryT * 12
                    )
                    head.AssemblyLinearVelocity = Vector3.zero
                end

                leftArmOffset = CFrame.new(-1.5, 1, -1.5) * CFrame.Angles(
                    -1.5707963267948966, 0, 0.26179938779914941
                ) * CFrame.new(0, -1, 0)
                rightArmOffset = CFrame.new(1.5, 1, -1.5) * CFrame.Angles(
                    -1.5707963267948966, 0, -0.26179938779914941
                ) * CFrame.new(0, -1, 0)
                leftLegOffset = CFrame.new(-0.5, -2, 0)
                rightLegOffset = CFrame.new(0.5, -2, 0)
            elseif Fun.angryState == "shock" then
                shockIntensity = math.min(Fun.angryStateTime * 4, 1)
                local nearestDistance = CFrame.Angles
                torsoOffset = CFrame.new(0, shockIntensity * 0.2, -shockIntensity * 0.3) * nearestDistance(
                    math.rad(-shockIntensity * 20), 0, 0
                )
                local Graph = CFrame.Angles
                leftArmOffset = CFrame.new(-1.5, 1 + shockIntensity * 1.2, -1.5) * Graph(
                    math.rad(-90 - shockIntensity * 80), 0, 0.52359877559829882
                ) * CFrame.new(0, -1, 0)
                local deltaZ = CFrame.Angles
                rightArmOffset = CFrame.new(1.5, 1 + shockIntensity * 1.2, -1.5) * deltaZ(
                    math.rad(-90 - shockIntensity * 80), 0, -0.52359877559829882
                ) * CFrame.new(0, -1, 0)
                leftLegOffset = CFrame.new(-0.6, -2, 0.1) * CFrame.Angles(
                    -0.087266462599716474, 0.26179938779914941, 0
                )
                rightLegOffset = CFrame.new(0.6, -2, -0.1) * CFrame.Angles(
                    -0.087266462599716474, -0.26179938779914941, 0
                )
            elseif Fun.angryState == "falling" then
                angryT = Fun.angryStateTime
                torsoOffset = CFrame.new(0, -0.3, 0) * CFrame.Angles(0.26179938779914941, 0, 0)

                if head then
                    fallHeight = 150 - angryT / 1.5 * 150
                    fallHeight = math.max(fallHeight, 1.5)
                    headWorldPos = (targetCFrame * CFrame.new(0, fallHeight, 0)).Position
                    head.CFrame = CFrame.new(headWorldPos) * CFrame.Angles(
                        angryT * 20, angryT * 15, angryT * 18
                    )
                    head.AssemblyLinearVelocity = Vector3.zero
                end

                leftArmOffset = CFrame.new(-1.5, 1.5, -1.5) * CFrame.Angles(
                    -2.2689280275926285, 0, 0.3490658503988659
                ) * CFrame.new(0, -1, 0)
                rightArmOffset = CFrame.new(1.5, 1.5, -1.5) * CFrame.Angles(
                    -2.2689280275926285, 0, -0.3490658503988659
                ) * CFrame.new(0, -1, 0)
                leftLegOffset = CFrame.new(-0.6, -2, 0.2)
                rightLegOffset = CFrame.new(0.6, -2, -0.2) * CFrame.Angles(0, 0.3490658503988659, 0)
            elseif Fun.angryState == "catch" then
                smooth = Fun.angryStateTime / 0.5
                local nearestDistance = CFrame.Angles
                torsoOffset = CFrame.new(0, -0.1 * (1 - smooth), 0) * nearestDistance(
                    math.rad(5 * (1 - smooth)), 0, 0
                )

                if head then
                    targetHeadCFrame = targetCFrame * CFrame.new(0, 1.5, 0)
                    head.CFrame = head.CFrame:Lerp(targetHeadCFrame, smooth)
                    head.AssemblyLinearVelocity = Vector3.zero
                end

                leftArmOffset = CFrame.new(-1, 1, -1.5) * CFrame.Angles(
                    -1.7453292519943295, -0.3490658503988659, 0.69813170079773179
                ) * CFrame.new(0, -0.8, 0)
                rightArmOffset = CFrame.new(1, 1, -1.5) * CFrame.Angles(
                    -1.7453292519943295, 0.3490658503988659, -0.69813170079773179
                ) * CFrame.new(0, -0.8, 0)
                leftLegOffset = CFrame.new(-0.5, -2, 0)
                rightLegOffset = CFrame.new(0.5, -2, 0)
            end

            offsets = {}

            if torsoOffset then
                offsets.Torso = torsoOffset
            end

            if headOffset then
                offsets.Head = headOffset
            end

            if leftArmOffset then
                offsets["Left Arm"] = leftArmOffset
            end

            if rightArmOffset then
                offsets["Right Arm"] = rightArmOffset
            end

            if leftLegOffset then
                offsets["Left Leg"] = leftLegOffset
            end

            if rightLegOffset then
                offsets["Right Leg"] = rightLegOffset
            end

            for prefix, char in pairs(offsets) do
                part = descendant:FindFirstChild(prefix)

                if part and part:IsA("BasePart") then
                    part.CFrame = targetCFrame * char
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    )
end

Fun.startSoccer = function(descendant)
    Fun.stopPose()
    rootPart = descendant:WaitForChild("HumanoidRootPart")
    humanoid = descendant:WaitForChild("Humanoid")
    head = descendant:FindFirstChild("Head")
    if not head then
        return
    end
    Fun.RagdollRemote:FireServer(rootPart, 9999999)
    movePosition = rootPart.Position
    walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
    teleportThreshold = 8
    soccerTime = 0
    Fun.activeMode = "dance"

    Fun.poseConnection = Fun.RunService.Heartbeat:Connect(
        function(alpha)
            if not descendant or not descendant.Parent or not rootPart or not rootPart.Parent then
                Fun.stopPose()
                return
            end
            soccerTime = soccerTime + alpha
            cameraLook = Fun.camera.CFrame.LookVector
            yawAngle = math.atan2(-cameraLook.X, -cameraLook.Z)
            actualPosition = rootPart.Position

            if (actualPosition - movePosition).Magnitude > teleportThreshold then
                movePosition = actualPosition
            end

            moveDir = humanoid.MoveDirection

            if moveDir.Magnitude > 0.01 then
                movePosition = movePosition + moveDir * walkSpeed * alpha
            end

            targetCFrame = CFrame.new(movePosition) * CFrame.Angles(0, yawAngle, 0)
            rootPart.CFrame = targetCFrame
            kickSpeed = 4
            cycle = soccerTime * kickSpeed
            phase = cycle % 1
            legLift = 0
            headBounce = 0

            if phase < 0.25 then
                legLift = phase / 0.25
                headBounce = 0
            elseif phase < 0.35 then
                legLift = 1
                headBounce = (phase - 0.25) / 0.1
            elseif phase < 0.65 then
                legLift = 1 - (phase - 0.35) / 0.3
                headBounce = 1
            elseif phase < 0.8 then
                legLift = 0
                headBounce = 1 - (phase - 0.65) / 0.15
            else
                legLift = 0
                headBounce = 0
            end

            headForward = -1.2
            headDown = 0.2 - headBounce * 4
            rightLegUp = 0.5 + legLift * 1.5
            rightLegForward = -0.5 - legLift * 0.7
            local nearestDistance = CFrame.Angles
            local radian = math.rad
            local elapsedTime = -legLift * 10

            offsets = {
                Torso = CFrame.new(0, 0, 0) * nearestDistance(math.rad(-legLift * 10), 0, 0),
                Head = CFrame.new(0, 1.5 - headDown, headForward) * CFrame.Angles(
                    headBounce * 3, soccerTime * 4, headBounce * 2
                ),
                ["Left Arm"] = CFrame.new(-1.5, 1, -1.5) * CFrame.Angles(
                    -1.7453292519943295, -0.3490658503988659, 0.52359877559829882
                ) * CFrame.new(0, -1, 0),
                ["Right Arm"] = CFrame.new(1.5, 1, -1.5) * CFrame.Angles(
                    -1.7453292519943295, 0.3490658503988659, -0.52359877559829882
                ) * CFrame.new(0, -1, 0), ["Left Leg"] = CFrame.new(-0.3, -2, 0.1),
                ["Right Leg"] = CFrame.new(0.5, -2 + rightLegUp, rightLegForward) * nearestDistance(
                    math.rad(-legLift * 100), 0, radian(elapsedTime)
                ),
            }

            for prefix, char in pairs(offsets) do
                part = descendant:FindFirstChild(prefix)

                if part and part:IsA("BasePart") then
                    part.CFrame = targetCFrame * char
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    )
end

Fun.startHeadOrbit = function(descendant)
    Fun.stopPose()
    rootPart = descendant:WaitForChild("HumanoidRootPart")
    humanoid = descendant:WaitForChild("Humanoid")
    torso = descendant:FindFirstChild("Torso") or descendant:FindFirstChild("UpperTorso")
    head = descendant:FindFirstChild("Head")
    if not torso or not head then
        return
    end
    Fun.RagdollRemote:FireServer(rootPart, 9999999)
    movePosition = rootPart.Position
    walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
    teleportThreshold = 8
    orbitTime = 0
    orbitSpeed = 3
    orbitRadius = 3
    orbitHeight = 0.5
    Fun.activeMode = "dance"

    Fun.poseConnection = Fun.RunService.Heartbeat:Connect(
        function(alpha)
            if not descendant or not descendant.Parent or not rootPart or not rootPart.Parent then
                Fun.stopPose()
                return
            end
            orbitTime = orbitTime + alpha
            cameraLook = Fun.camera.CFrame.LookVector
            yawAngle = math.atan2(-cameraLook.X, -cameraLook.Z)
            actualPosition = rootPart.Position

            if teleportThreshold < (actualPosition - movePosition).Magnitude then
                movePosition = actualPosition
            end

            moveDir = humanoid.MoveDirection

            if moveDir.Magnitude > 0.01 then
                movePosition = movePosition + moveDir * walkSpeed * alpha
            end

            targetCFrame = CFrame.new(movePosition) * CFrame.Angles(0, yawAngle, 0)
            rootPart.CFrame = targetCFrame
            torsoWorldPos = (targetCFrame * CFrame.new(0, 0.5, 0)).Position
            orbitAngle = orbitTime * orbitSpeed
            local lower = orbitRadius
            headOffsetX = math.cos(orbitAngle) * lower
            local spawnPosition = orbitRadius
            headOffsetZ = math.sin(orbitAngle) * spawnPosition
            headWorldPos = torsoWorldPos + Vector3.new(headOffsetX, orbitHeight, headOffsetZ)
            tangentX = -math.sin(orbitAngle)
            tangentZ = math.cos(orbitAngle)
            headForward = Vector3.new(tangentX, 0, tangentZ)
            headLookCFrame = CFrame.new(headWorldPos, headWorldPos + headForward)
            headFinalCFrame = headLookCFrame * CFrame.Angles(0, 0, orbitTime * 5)

            offsets = {
                Torso = CFrame.new(0, 0, 0), Head = targetCFrame:ToObjectSpace(headFinalCFrame),
                ["Left Arm"] = CFrame.new(-1.5, 1, 0) * CFrame.Angles(
                    -2.0943951023931953, 0, 0.52359877559829882
                ) * CFrame.new(0, -1, 0),
                ["Right Arm"] = CFrame.new(1.5, 1, 0) * CFrame.Angles(
                    -2.0943951023931953, 0, -0.52359877559829882
                ) * CFrame.new(0, -1, 0), ["Left Leg"] = CFrame.new(-0.5, -2, 0),
                ["Right Leg"] = CFrame.new(0.5, -2, 0),
            }

            for prefix, currentPlayer in pairs(offsets) do
                part = descendant:FindFirstChild(prefix)

                if part and part:IsA("BasePart") then
                    part.CFrame = targetCFrame * currentPlayer
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    )
end

