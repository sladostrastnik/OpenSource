        if workerCount and workerCount.Value == true then
            return false
        end
        local newPlayer, shooter, playerUserId = emitterInstance.charp(descendant)
        if not newPlayer or not shooter or not playerUserId or playerUserId.Health <= 0 then
            return false
        end

        if not newPlayer:FindFirstChild("Torso") then
            return false
        end
        local inventory = getRecoveredKickPosition(ray, point, object)
        prepareNetworkKickMovers(shooter, inventory)

        if emitterInstance.getMagnitude(ray, shooter) > 33 then
            if not emitterInstance.sno(shooter) then
                return false
            end
            emitterInstance.teleport(shooter, inventory)
        end

        emitterInstance.grab(shooter)
        releaseKickOwnership(shooter, beamInstance.NKDelayMode)

        if properties.RagdollInNK then
            task.spawn(emitterInstance.ragdoll, newPlayer)
        end

        if properties.DeleteShurInNK then
            task.spawn(emitterInstance.removesticky, newPlayer)
        end

        emitterInstance.ToggleCollisions(newPlayer, false)
        emitterInstance.RepositionLimbs(newPlayer, true)

        if not v then
            task.delay(
                0.5,
                function()
                    pcall(cleanupNetworkKickPlayer, descendant)
                    tree[descendant] = nil
                end
            )
        end

        return true
    end

