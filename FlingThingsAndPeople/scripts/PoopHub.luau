                    rainParticle.Lifetime = NumberRange.new(emitterInstance.LifeMin, emitterInstance.LifeMax)
                    rainParticle.Size = NumberSequence.new(emitterInstance.SizeStart, emitterInstance.SizeEnd)
                    rainParticle.Acceleration = Vector3.new(0, -emitterInstance.Gravity, 0)
