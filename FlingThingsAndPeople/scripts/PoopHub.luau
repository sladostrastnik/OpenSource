do
    local result51 = rows.Character:AddRightGroupbox("Free Camera")
    local segmentPart = rows.Character:AddLeftGroupbox("Body Material Override")
    local sortedArray = false
    local cost = true
    local changed = false
    local content = "ForceField"
    local bestDistance = Color3.fromRGB(180, 200, 255)
    local openSet = {}
    local emitterInstance = {}
    local bestChild = nil

    setBodyVisible = function(descendant)
        local characterModel = playerInstance.Character
        if not characterModel then
            return
        end

        for _, projectile in ipairs(characterModel:GetDescendants()) do
            if projectile:IsA("BasePart") then
                pcall(
                    function()
                        projectile.LocalTransparencyModifier = descendant and 0 or 0
                    end
                )
            end
        end
    end

    applyBodyMaterial = function()
        local characterModel = playerInstance.Character
        if not characterModel then
            return
        end

        if bestChild then
            pcall(
                function()
                    bestChild:Destroy()
                end
            )
        end

        bestChild = Instance.new("Folder")
        bestChild.Name = "_phBodyMatStash"
        bestChild.Parent = playerInstance
        emitterInstance = {}

        for _, newPart in ipairs(characterModel:GetChildren()) do
            if newPart:IsA("Shirt") or newPart:IsA("Pants") or newPart:IsA("ShirtGraphic") then
                local npcModel = newPart.Parent
                newPart.Parent = bestChild
                table.insert(emitterInstance, {obj = newPart, orig = npcModel})
            end
        end

        for _, projectile in ipairs(characterModel:GetDescendants()) do
            if projectile:IsA("SurfaceAppearance") then
                local npcModel = projectile.Parent
                projectile.Parent = bestChild
                table.insert(emitterInstance, {obj = projectile, orig = npcModel})
            end
        end

        openSet = {}

        for _, projectile in ipairs(characterModel:GetDescendants()) do
            if projectile:IsA("BasePart") and projectile.Name ~= "HumanoidRootPart" then
                openSet[projectile] = {mat = projectile.Material, col = projectile.Color}

                pcall(
                    function()
                        projectile.Material = Enum.Material[content]
                        projectile.Color = bestDistance
                    end
                )
            end
        end
    end

    removeBodyMaterial = function()
        for prefix, modelTemplate in pairs(openSet) do
            if prefix and prefix.Parent then
                pcall(
                    function()
                        prefix.Material = modelTemplate.mat
                        prefix.Color = modelTemplate.col
                    end
                )
            end
        end

        openSet = {}

        for _, modelTemplate in ipairs(emitterInstance) do
            pcall(
                function()
                    modelTemplate.obj.Parent = modelTemplate.orig
                end
            )
        end

        emitterInstance = {}

        if bestChild then
            pcall(
                function()
                    bestChild:Destroy()
                end
            )

            bestChild = nil
        end
    end

    playerInstance.CharacterAdded:Connect(
        function()
            if changed then
                task.wait(1.5)
                applyBodyMaterial()
            end
        end
    )

    local first = false
    local keys = nil

    startBodyMatRainbow = function()
        if keys then
            return
        end

        keys = runService.RenderStepped:Connect(
            function()
                if not changed then
                    return
                end
                local color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                bestDistance = color

                for prefix in pairs(openSet) do
                    if prefix and prefix.Parent then
                        pcall(
                            function()
                                prefix.Color = color
                            end
                        )
                    end
                end
            end
        )
    end

    stopBodyMatRainbow = function()
        if keys then
            keys:Disconnect()
            keys = nil
        end
    end

    enableFreeCamera = function()
        sortedArray = true
        local characterModel = playerInstance.Character

        if characterModel then
            local columnIndex = characterModel:FindFirstChild("HumanoidRootPart")

            if columnIndex then
                columnIndex.Anchored = true
            end
        end

        if cost then
            setBodyVisible(true)
        end
    end

    disableFreeCamera = function()
        sortedArray = false
        local characterModel = playerInstance.Character

        if characterModel then
            local columnIndex = characterModel:FindFirstChild("HumanoidRootPart")

            if columnIndex then
                columnIndex.Anchored = false
            end
        end

        UIS.MouseBehavior = Enum.MouseBehavior.Default

        pcall(
            function()
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            end
        )
    end

    result51:AddToggle(
        "FreeCamToggle",
        {
            Text = "Enable Free Camera", Default = false,
            Callback = function(descendant)
                if descendant then
                    enableFreeCamera()
                else
                    disableFreeCamera()
                end

                _NOTIFY(descendant and "Free Camera ON (Character Anchored)" or "Free Camera OFF", 3)
            end,
        }
    )

    result51:AddToggle(
        "FreeCamShowBody",
        {
            Text = "Show Own Body", Default = true,
            Callback = function(descendant)
                cost = descendant

                if sortedArray then
                    setBodyVisible(descendant)
                end
            end,
        }
    )

    segmentPart:AddToggle(
        "BodyMatToggle",
        {
            Text = "Enable Body Material", Default = false,
            Callback = function(descendant)
                changed = descendant

                if descendant then
                    applyBodyMaterial()
                else
                    removeBodyMaterial()
                end

                _NOTIFY(descendant and "Body Material: " .. content .. " ON" or "Body Material OFF", 3)
            end,
        }
    ):AddColorPicker(
        "BodyMatColor",
        {
            Default = Color3.fromRGB(180, 200, 255), Title = "Body Color",
            Callback = function(output)
                bestDistance = output

                if changed then
                    for prefix in pairs(openSet) do
                        if prefix and prefix.Parent then
                            pcall(
                                function()
                                    prefix.Color = output
                                end
                            )
                        end
                    end
                end
            end,
        }
    )

    segmentPart:AddDropdown(
        "BodyMaterialDd",
        {
            Text = "Select Material",
            Values = {
                "ForceField", "Neon", "Glass", "Metal", "SmoothPlastic", "Plastic", "Wood",
                "Marble", "Granite", "Slate", "WoodPlanks", "Cobblestone", "Brick", "Fabric",
            }, Default = 1,
            Callback = function(descendant)
                content = descendant

                if changed then
                    removeBodyMaterial()
                    applyBodyMaterial()
                end
            end,
        }
    )

    segmentPart:AddButton(
        {
            Text = "Re-apply (after respawn / refresh)",
            Func = function()
                if changed then
                    removeBodyMaterial()
                    applyBodyMaterial()
                    _NOTIFY("Body material re-applied!", 3)
                else
                    _NOTIFY("Enable Body Material first", 2)
                end
            end,
        }
    )

    segmentPart:AddLabel("Clothing is hidden while enabled")
    segmentPart:AddLabel("Materials: ForceField, Neon, Glass ...")

    segmentPart:AddToggle(
        "BodyMatRainbow",
        {
            Text = "Rainbow Body Material", Default = false,
            Callback = function(descendant)
                first = descendant

                if descendant then
                    startBodyMatRainbow()
                else
                    stopBodyMatRainbow()
                end

                _NOTIFY(descendant and "Body Rainbow ON" or "Body Rainbow OFF", 3)
            end,
        }
    )
end

do
    local array = rows.Character:AddRightGroupbox("Umbrella")
    local result51 = rows.Character:AddRightGroupbox("Local Aura")
    local sortedArray = false
    local cost = false
    local average = 0.3
    local bestDistance = Color3.fromRGB(255, 255, 255)
    local cell = Enum.Material.Neon
    local top = 2.4
    local screenPosition = 1.1
    local segmentPart = nil
    local keys = nil

    destroyHat = function()
        if segmentPart then
            pcall(
                function()
                    segmentPart:Destroy()
                end
            )

            segmentPart = nil
        end

        if keys then
            keys:Disconnect()
            keys = nil
        end
    end

    buildHat = function()
        destroyHat()
        local characterModel = playerInstance.Character
        if not characterModel then
            return
        end
        local explosion = characterModel:FindFirstChild("Head")
        if not explosion then
            return
        end
        local stepPart = Instance.new("Part")
        stepPart.Name = "_phChineseHat"
        stepPart.Transparency = average
        stepPart.Color = bestDistance
        stepPart.Material = cell
        stepPart.CanCollide = false
        stepPart.CanTouch = false
        stepPart.CanQuery = false
        stepPart.Massless = true
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshId = "rbxassetid://1033714"
        mesh.Scale = Vector3.new(top, top * 0.66666666666666674, top)
        mesh.Parent = stepPart
        local motor = Instance.new("WeldConstraint")
        motor.Part0 = explosion
        motor.Part1 = stepPart
        motor.Parent = stepPart
        stepPart.CFrame = explosion.CFrame * CFrame.new(0, screenPosition, 0)
        stepPart.Parent = characterModel
        segmentPart = stepPart

        if cost then
            keys = runService.RenderStepped:Connect(
                function()
                    if not sortedArray or not segmentPart then
                        return
                    end
                    local radians = tick() % 5 / 5

                    pcall(
                        function()
                            segmentPart.Color = Color3.fromHSV(radians, 1, 1)
                        end
                    )
                end
            )
        end
    end

    local changed = false
    local openSet = {"Godly"}
    local content = ""
    local fileName = "Auto"
    local emitterInstance = {}
    local beamInstance = {}
    local radians = 1
    local properties = {}

    local wheel = {
        Godly = "rbxassetid://16699750981", ["Super Sayien"] = "rbxassetid://116109508364297",
        ["North Star"] = "rbxassetid://83945069652732", ["Blue Lord"] = "rbxassetid://10974316799",
        ["Pink Aura"] = "rbxassetid://115980859615239",
        ["Angel Wing"] = "rbxassetid://90022969696073",
        ["Sweet Heart"] = "rbxassetid://91724768175470",
        ["Ethereal Aura"] = "rbxassetid://97041568674250",
    }

    disableAura = function()
        for _, modelTemplate in ipairs(beamInstance) do
            if modelTemplate and modelTemplate.Parent then
                pcall(
                    function()
                        modelTemplate:Destroy()
                    end
                )
            end
        end

        table.clear(beamInstance)
        table.clear(properties)
        local characterModel = playerInstance.Character

        if characterModel then
            local instance2 = characterModel:FindFirstChild("_phAuraFeetPart")

            if instance2 then
                pcall(
                    function()
                        instance2:Destroy()
                    end
                )
            end
        end
    end

    enableAura = function()
        disableAura()
        local characterModel = playerInstance.Character
        if not characterModel or #emitterInstance == 0 then
            return
        end

        for _, modelTemplate in ipairs(emitterInstance) do
            local tool = modelTemplate:Clone()

            for _, projectile in ipairs(tool:GetDescendants()) do
                if not projectile:IsA("BasePart") then
                    local stack = projectile:Clone()
                    local moduleName = projectile.Parent and projectile.Parent.Name
                    local targetPart

                    if fileName == "Auto" then
                        targetPart = moduleName and characterModel:FindFirstChild(moduleName) or characterModel:FindFirstChildWhichIsA(
                            "BasePart"
                        )
                    elseif fileName == "Under Feet" then
                        local columnIndex = characterModel:FindFirstChild("HumanoidRootPart")
                        targetPart = nil

                        if columnIndex then
                            targetPart = characterModel:FindFirstChild("_phAuraFeetPart")

                            if not targetPart then
                                targetPart = Instance.new("Part")
                                targetPart.Name = "_phAuraFeetPart"
                                targetPart.Transparency = 1
                                targetPart.CanCollide = false
                                targetPart.Anchored = false
                                targetPart.Massless = true
                                targetPart.Size = Vector3.one
                                local motor = Instance.new("WeldConstraint")
                                motor.Part0 = columnIndex
                                motor.Part1 = targetPart
                                motor.Parent = targetPart
                                targetPart.CFrame = columnIndex.CFrame * CFrame.new(0, -3.1, 0)
                                targetPart.Parent = characterModel
                            end
                        end
                    else
                        targetPart = characterModel:FindFirstChild(fileName) or characterModel:FindFirstChild(
                            "HumanoidRootPart"
                        )
                    end

                    if targetPart then
                        stack.Parent = targetPart
                        table.insert(beamInstance, stack)

                        applyRate = function(descendant)
                            if descendant:IsA("ParticleEmitter") then
                                properties[descendant] = descendant.Rate
                                descendant.Rate = descendant.Rate * radians
                            end
                        end

                        applyRate(stack)

                        for _, row in ipairs(stack:GetDescendants()) do
                            applyRate(row)
                        end
                    end
                end
            end

            tool:Destroy()
        end
    end

    updateAuraLogic = function()
        local sorted = {}

        if content ~= "" then
            table.insert(sorted, "rbxassetid://" .. content:gsub("%D", ""))
        elseif type(openSet) == "table" then
            for prefix, modelTemplate in pairs(openSet) do
                modelTemplate = modelTemplate and wheel[prefix]

                if modelTemplate then
                    table.insert(sorted, wheel[prefix])
                end
            end
        elseif type(openSet) == "string" and wheel[openSet] then
            table.insert(sorted, wheel[openSet])
        end

        table.clear(emitterInstance)

        for prefix, modelTemplate in pairs(sorted) do
            local parsed, sourceString = pcall(
                function()
                    return game:GetObjects(modelTemplate)[1]
                end
            )

            if parsed and sourceString then
                prefix = type(prefix) == "string" and prefix or "Custom"
                sourceString.Name = prefix
                table.insert(emitterInstance, sourceString)
            end
        end

        if changed then
            enableAura()
        end
    end

    playerInstance.CharacterAdded:Connect(
        function()
            task.wait(1.5)

            if sortedArray then
                buildHat()
            end

            if changed then
                enableAura()
            end
        end
