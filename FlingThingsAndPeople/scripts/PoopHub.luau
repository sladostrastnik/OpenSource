            return false
        end
        local secondElement = inputTable[descendant]

        if not secondElement then
            secondElement = {}
            inputTable[descendant] = secondElement
        end

        if not table.find(secondElement, object) then
            table.insert(secondElement, object)
        end

        if result33[descendant] then
            return true
        end
        result33[descendant] = true

        task.spawn(
            function()
                while #secondElement > 0 do
                    local packed = table.remove(secondElement, 1)

                    if packed and packed.Parent then
                        local parsed, sourceString = pcall(point, packed)

                        if not parsed then
                            local ray = tostring
                            warn(
