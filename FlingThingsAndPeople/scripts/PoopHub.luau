Fun.spawnAndAttachToy = function(descendant)
    if not Fun.SelectedPlayerForToy then
        return
    end

    pcall(
        function()
            local columnIndex = (playerInstance.Character or playerInstance.CharacterAdded:Wait()):WaitForChild(
                "HumanoidRootPart"
            )
            local characterModel = Fun.SelectedPlayerForToy.Character
            if not characterModel then
                return
            end
            local marker = characterModel:FindFirstChild("Torso") or characterModel:FindFirstChild(
                "UpperTorso"
            ) or characterModel:FindFirstChild("HumanoidRootPart")
            if not marker then
                return
            end
            root.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                descendant, columnIndex.CFrame, Vector3.zero
            )
            task.wait(0.1)
            local lower = workspace:FindFirstChild(playerInstance.Name .. "SpawnedInToys")
            if not lower then
                return
            end
            local spawnPosition = lower:FindFirstChild(descendant)
            if not spawnPosition then
                return
            end
            local moduleFolder = spawnPosition:FindFirstChild("StickyPart")
            local HumanoidRootPart = spawnPosition:FindFirstChild("SoundPart")
            if not moduleFolder or not HumanoidRootPart then
                return
            end
            root.GrabEvents.SetNetworkOwner:FireServer(HumanoidRootPart, marker.CFrame)
            local otherVector = math.rad(Fun.rotationX)
            local rotationAngle = math.rad(Fun.rotationY)
            local randomYaw = math.rad(Fun.rotationZ)
            root.PlayerEvents.StickyPartEvent:FireServer(
                moduleFolder, marker, CFrame.new(0, -1, 0) * CFrame.Angles(otherVector, rotationAngle, randomYaw)
            )
        end
    )
end

