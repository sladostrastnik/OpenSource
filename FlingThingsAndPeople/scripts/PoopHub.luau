do
    local result51 = rows.Kick:AddLeftGroupbox("Loop Kick Blob")
    local segmentPart = rows.Kick:AddRightGroupbox("Loop Kick Settings")

    local playerIdentifier = result51:AddDropdown(
        "LoopKickBlobTargetDropdown",
        {
            Text = "Loop Kick Target", Values = GetPlayerListDisplay(), Default = 1,
            Callback = function(descendant)
                local innerPlayer = ExtractUsername(descendant)

                if innerPlayer then
                    grid.loopKickBlobTarget = innerPlayer
                end
            end,
        }
    )

    setupAutoRefresh(playerIdentifier)

    result51:AddToggle(
        "LoopKickBlobToggle",
        {
            Text = "Loop Kick Blob (Single Target)", Default = false,
            Callback = function(player83)
                grid.loopKickBlobActive = player83

                if player83 then
                    if not grid.loopKickBlobTarget then
                        _NOTIFY("Loop Kick: Please select a target first", 3)
                        grid.loopKickBlobActive = false

                        if index16.LoopKickBlobToggle then
                            index16.LoopKickBlobToggle:SetValue(false)
                        end

                        return
                    end

                    _G.loopKickBlobTask = task.spawn(
                        function()
                            LoopKickBlobFunction(grid.loopKickBlobTarget)
                        end
                    )

                    _NOTIFY("Loop Kick Blob: Started on " .. grid.loopKickBlobTarget, 3)
                else
                    grid.loopKickBlobActive = false
                    _NOTIFY("Loop Kick Blob: Stopped", 2)
                end
            end,
        }
    )

    segmentPart:AddDropdown(
        "LoopKickBlobModeDropdown",
        {
            Text = "Loop Kick Mode", Values = {"Default", "TP to Sky"}, Default = 1,
            Callback = function(player84)
                grid.loopKickBlobMode = player84
            end,
        }
    )

    local sortedArray = false
    local innerPlayer = nil
    local top = 10
    local cost = true
    local openSet = {}
    local changed = false
    local first = false
    local thread = nil

    local emitterInstance = {
        Players = game:GetService("Players"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        RunService = game:GetService("RunService"),
    }

    local PLAYER = emitterInstance.Players.LocalPlayer

    local function onPlayerRemoving()
        return PLAYER.Character
    end

    local function generateRandomPoints()
        local snapshot = onPlayerRemoving()
        return snapshot and snapshot:FindFirstChildOfClass("Humanoid")
    end

    local function vectorLength()
        local snapshot = onPlayerRemoving()
        if not snapshot then
            return nil
        end
        return snapshot:FindFirstChild("HumanoidRootPart") or snapshot:FindFirstChild("Torso")
    end

    local function vectorAdd()
        return workspace:FindFirstChild(PLAYER.Name .. "SpawnedInToys")
    end

    local function createNode(descendant)
        if not descendant then
            return nil
        end
        local previous = descendant:FindFirstAncestorOfClass("Model")
        if previous and previous.Name == "CreatureBlobman" then
            return previous
        end
        return nil
    end

    local function generateRandomString()
        if innerPlayer and innerPlayer.Parent then
            local RemoteFunction = emitterInstance.ReplicatedStorage:FindFirstChild("MenuToys")
            local offset = RemoteFunction and RemoteFunction:FindFirstChild("DestroyToy")

            if offset then
                offset:FireServer(innerPlayer)
            else
                innerPlayer:Destroy()
            end
        end

        innerPlayer = nil
    end

    local function subtractVectors(descendant)
        local snapshot = vectorLength()
        if not (descendant and snapshot) then
            return
        end
        emitterInstance.ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(descendant, snapshot.CFrame)
    end

    local function crossProduct(descendant, point)
        local screenPosition = os.clock() + (point or 3)
        task.wait()

        while os.clock() < screenPosition do
            if not (descendant and descendant.Parent) then
                return false
            end
            subtractVectors(descendant)
            task.wait()
            if not (descendant and descendant.Parent) then
                return false
            end
            local radians = descendant.Position.Y + 0.1
            descendant.CFrame = descendant.CFrame + Vector3.new(0, 0.1, 0)
            task.wait()
            if not (descendant and descendant.Parent) then
                return false
            end

            if not (radians - 0.05 <= descendant.Position.Y) then
                continue
            end
            return true
        end

        return false
    end

    local function generateRandomArray(descendant, point, object)
        local snapshot = descendant and descendant:FindFirstChild(object .. "Detector")
        local minutes = snapshot and snapshot:FindFirstChild(object .. "Weld")
        local remoteEvent = descendant and descendant:FindFirstChild("BlobmanSeatAndOwnerScript")
        remoteEvent = remoteEvent and remoteEvent:FindFirstChild(
            "CreatureGrab"
        )

        if snapshot and minutes and remoteEvent and point then
            remoteEvent:FireServer(snapshot, point, minutes)
        end
    end

    local function createClass(descendant)
        if descendant then
            emitterInstance.ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(descendant)
        end
    end

    local function deepCopyTable(descendant, point, object)
        local snapshot = generateRandomPoints()
        if not (snapshot and snapshot.Sit and innerPlayer and innerPlayer.Parent and point) then
            return
        end

        for k = 1, 3 do
            generateRandomArray(descendant, vectorLength(), object)
        end

        task.wait(0.12)
        crossProduct(point, 2)

        if point and point.Parent then
            for k = 1, 2 do
                point.CFrame = point.CFrame + Vector3.new(0, 20, 0)
            end
        end

        createClass(point)
        task.wait(0.02)
        generateRandomArray(descendant, point, object)
    end

    local function createVector(descendant)
        return descendant and descendant.UserId and PLAYER:IsFriendsWith(descendant.UserId)
    end

    local function generateUniqueIdentifier(descendant)
        return descendant.InPlot and descendant.InPlot.Value
    end

    local function createVector3(descendant)
        local characterModel = descendant.Character
        if not characterModel then
            return false
        end
        local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")
        return targetHumanoid and targetHumanoid.Health > 0
    end

    local function mainLoop(descendant)
        for _, projectile in ipairs(descendant:GetDescendants()) do
            if projectile:IsA("BodyForce") or projectile:IsA("BodyVelocity") or projectile:IsA(
                "BodyAngularVelocity"
            ) or projectile:IsA("BodyGyro") or projectile:IsA("VectorForce") or projectile:IsA(
                "LinearVelocity"
            ) or projectile:IsA("AngularVelocity") or projectile:IsA("AlignPosition") or projectile:IsA(
                "AlignOrientation"
            ) then
                projectile:Destroy()
            end
        end
    end

    local function Scheduler(descendant)
        local snapshot = onPlayerRemoving()
        if not snapshot then
            return
        end

        for _, projectile in ipairs(snapshot:GetDescendants()) do
            if projectile:IsA("BasePart") then
                projectile.CanCollide = not descendant
            end
        end
    end

    local function onInputBegan()
        if not innerPlayer then
            return
        end
        local encoded = innerPlayer:FindFirstChild("LeftDetector", true)
        if not encoded then
            return
        end
        local gui = encoded:FindFirstChild("AttachPlayer")

        if gui then
            gui:Destroy()
        end
    end

    local function initialize()
        if not first then
            return
        end
        local snapshot = generateRandomPoints()
        local minutes = vectorLength()
        if not (snapshot and minutes) then
            return
        end

        if snapshot.SeatPart then
            local seconds = createNode(snapshot.SeatPart)
            if seconds then
                innerPlayer = seconds
                return
            end
        end

        if not (innerPlayer and innerPlayer.Parent) then
            local RemoteFunction = emitterInstance.ReplicatedStorage:FindFirstChild("MenuToys")
            RemoteFunction = RemoteFunction and RemoteFunction:FindFirstChild("SpawnToyRemoteFunction")
            if not RemoteFunction then
                return
            end
            RemoteFunction:InvokeServer(
                "CreatureBlobman", minutes.CFrame * CFrame.new(0, 0, -5), Vector3.new(0, -15.716, 0)
            )
            local seconds = vectorAdd()

            if seconds then
                for _, newPart in ipairs(seconds:GetChildren()) do
                    if newPart.Name == "CreatureBlobman" and newPart:FindFirstChildOfClass(
                        "VehicleSeat"
                    ) then
                        innerPlayer = newPart
                        break
                    end
                end
            end
        end

        local terrain = innerPlayer and innerPlayer:FindFirstChildOfClass("VehicleSeat")

        if terrain and not snapshot.Sit then
            terrain:Sit(snapshot)
        end
    end

    local function serializeTable(descendant)
        descendant = descendant and descendant.Character
        if not descendant then
            return nil
        end
        return descendant:FindFirstChild("HumanoidRootPart") or descendant:FindFirstChild("Torso")
    end

    local function initializeSystem(descendant)
        if descendant == PLAYER then
            return false
        end

        if not createVector3(descendant) then
            return false
        end
        local seed = true

        if cost then
            seed = createVector(descendant)
        end

        if seed then
            return false
        end

        if generateUniqueIdentifier(descendant) then
            return false
        end
        local characterModel = descendant.Character
        local snapshot = openSet[descendant.UserId]
        local currentQuantity

        if snapshot then
            local osTime = snapshot.time
            currentQuantity = os.clock() - osTime < top
        else
            currentQuantity = snapshot
        end

        if currentQuantity and snapshot.char == characterModel then
            return false
        end
        local minutes = serializeTable(descendant)
        if not minutes then
            return false
        end
        return true, minutes, characterModel
    end

    local function addVectors()
        local snapshot = vectorLength()
        if not snapshot then
            return {}
        end
        local beamInstance = {}

        for _, playerObject in ipairs(emitterInstance.Players:GetPlayers()) do
            local minutes, seconds, jsonString = initializeSystem(playerObject)

            if minutes then
                beamInstance[#beamInstance + 1] = {
                    player = playerObject, root = seconds, char = jsonString,
                    distance = (seconds.Position - snapshot.Position).Magnitude
                }
            end
        end

        table.sort(
            beamInstance,
            function(descendant, point)
                return descendant.distance < point.distance
            end
        )

        return beamInstance
    end

    emitterInstance.RunService.Heartbeat:Connect(
        function()
            if not sortedArray or not first then
                return
            end
            initialize()
            local snapshot = generateRandomPoints()
            local empty = snapshot and snapshot.Sit or false

            if empty and not changed then
                first = false
            end

            changed = empty
        end
    )

    local function calculateDistance()
        if thread then
            thread = nil
        end

        first = true
        changed = false

        thread = task.spawn(
            function()
                while sortedArray do
                    local snapshot = generateRandomPoints()

                    if snapshot and snapshot.Sit and innerPlayer and innerPlayer.Parent then
                        local minutes = vectorLength()

                        if minutes then
                            onInputBegan()
                            local seconds = addVectors()

                            if #seconds == 0 then
                                task.wait()
                            else
                                for _, sample in ipairs(seconds) do
                                    if sortedArray then
                                        local functionReference = sample.player
                                        local rootNode = sample.root
                                        local clone = sample.char

                                        if functionReference and rootNode and clone and clone.Parent then
                                            local screenSize = rootNode.Position
                                            local screenPosition = screenSize.Y - 7
                                            local currentCFrame = minutes.CFrame
                                            Scheduler(true)
                                            minutes.CFrame = CFrame.new(screenSize.X, screenPosition, screenSize.Z)
                                            local seed = true

                                            local taskSpawn = task.spawn(
                                                function()
                                                    local theta = math.atan2(
                                                        minutes.Position.Z - screenSize.Z,
                                                        minutes.Position.X - screenSize.X
                                                    )

                                                    while seed and sortedArray and rootNode.Parent and clone.Parent do
                                                        theta += 50 * task.wait()
                                                        local maxZ = screenSize.Z
                                                        minutes.CFrame = CFrame.new(
                                                            Vector3.new(
                                                                screenSize.X + math.cos(theta) * 20, screenPosition,
                                                                maxZ + math.sin(theta) * 20
                                                            ),
                                                            Vector3.new(screenSize.X, screenPosition, screenSize.Z)
                                                        )
                                                    end
                                                end
                                            )

                                            deepCopyTable(innerPlayer, rootNode, "Left")
                                            seed = false
                                            task.cancel(taskSpawn)
                                            minutes.CFrame = currentCFrame
                                            Scheduler(false)
                                            mainLoop(clone)
                                            openSet[functionReference.UserId] = {time = os.clock(), char = clone}
                                            task.wait(0.02)
                                        end

                                        continue
                                    end

                                    break
                                end

                                task.wait(0)
                            end
                        else
                            task.wait()
                        end
                    else
                        first = true
                        task.wait()
                    end
                end
            end
        )
    end

    local function traverse()
        sortedArray = false

        if thread then
            thread = nil
        end

        first = false
        changed = false
        openSet = {}
        generateRandomString()
    end

    segmentPart:AddToggle(
        "LoopKickAllBeta",
        {
            Text = "Loop Kick All (Beta)", Default = false,
            Callback = function(descendant)
                sortedArray = descendant

                if descendant then
                    calculateDistance()
                else
                    traverse()
                end
            end,
        }
    )
end

