destroyLineOnPlayer = function(descendant)
    if not newRoot then
        return
    end
    local handle = newRoot:FindFirstChild("CreateGrabLine")
    local response = newRoot:FindFirstChild("DestroyGrabLine")
    if not handle or not response then
        return
    end

    pcall(
        function()
            handle:FireServer(descendant, CFrame.new(3e9, 4e9, 2e9))
            task.wait()
            response:FireServer(descendant)
        end
    )
end

do
    local batch = {}
    local sortedArray = false
    local cost = false
    grid.lineLagIntensity = 520
    grid.lineLagDelay = 1

    startLineLag = function()
        if sortedArray then
            return
        end
        sortedArray = true

        local thread = coroutine.create(
            function()
                while sortedArray do
                    local hitHumanoid = root:FindFirstChild("GrabEvents")
                    hitHumanoid = hitHumanoid and hitHumanoid:FindFirstChild("CreateGrabLine")

                    if hitHumanoid then
                        local previousLogIndex = rootGuiObject:FindFirstChild("SpawnLocation") or rootGuiObject:FindFirstChild(
                            "Spawn"
                        ) or playerInstance.Character and playerInstance.Character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                        if previousLogIndex then
                            local vertexCount = grid.lineLagIntensity or 520

                            for k = 1, vertexCount do
                                if sortedArray then
                                    local top = math.random(-2140500000, 2104000001)
                                    local screenPosition = math.random(-2.11e9, 2101000000)
                                    hitHumanoid:FireServer(previousLogIndex, CFrame.new(top, 0, screenPosition))
                                    continue
                                end

                                break
                            end
                        end
                    end

                    if sortedArray then
                        task.wait(grid.lineLagDelay or 1)
                    end
                end
            end
        )

        table.insert(batch, thread)
        coroutine.resume(thread)
    end

    stopLineLag = function()
        sortedArray = false
        task.wait(0.1)

        for _, definition in ipairs(batch) do
            pcall(coroutine.close, definition)
        end

        batch = {}
    end

    _G.kt_startLineLag = startLineLag
    _G.kt_stopLineLag = stopLineLag

    executeNoBlobKick = function()
        if cost then
            return
        end
        cost = true

        task.spawn(
            function()
                sortedArray = false
                startLineLag()
                local spawnPosition = getAllPlayers()
                if #spawnPosition == 0 then
                    cost = false
                    return
                end
                local edgeList = {}

                for _, currentPlayer in ipairs(spawnPosition) do
                    if not IsInPlot(currentPlayer) then
                        table.insert(edgeList, currentPlayer)
                    end
                end

                if #edgeList == 0 then
                    stopLineLag()
                    cost = false
                    return
                end

                local characterModel = playerInstance.Character
                characterModel = characterModel and characterModel:FindFirstChild("HumanoidRootPart")
                if not characterModel then
                    cost = false
                    return
                end
                local rows = {}

                for _, currentPlayer in ipairs(edgeList) do
                    local playerCharacter = currentPlayer.Character
                    playerCharacter = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")

                    if playerCharacter then
                        table.insert(rows, {player = currentPlayer, hrp = playerCharacter})
                    end
                end

                for _, currentPlayer in ipairs(rows) do
                    teleportToPlayer(characterModel, currentPlayer.hrp)
                    task.wait(0.16)
                    spamOwnership(currentPlayer.hrp)
                    spamOwnership(currentPlayer.hrp)
                    task.wait()
                    spamOwnership(currentPlayer.hrp)
                    task.wait()
                    spamOwnership(currentPlayer.hrp)
                    spamOwnership(currentPlayer.hrp)
                end

                local top = 6.2831853071795862 / #rows

                for k, currentPlayer in ipairs(rows) do
                    local screenPosition = (k - 1) * top
                    local radians = math.cos(screenPosition) * 80
                    local difference = math.sin(screenPosition) * 80

                    pcall(
                        function()
                            currentPlayer.hrp.CFrame = CFrame.new(radians, 32, difference)
                            currentPlayer.hrp.AssemblyLinearVelocity = Vector3.zero
                            currentPlayer.hrp.Velocity = Vector3.zero
                        end
                    )

                    local RemoteEvent = Instance.new("BodyPosition")
                    RemoteEvent.MaxForce = Vector3.new(3e9, 4e9, 3e9)
                    RemoteEvent.P = 50000000
                    RemoteEvent.Position = Vector3.new(radians, 32, difference)
                    RemoteEvent.Parent = currentPlayer.hrp

                    task.delay(
                        3,
                        function()
                            pcall(
                                function()
                                    RemoteEvent:Destroy()
                                end
                            )
                        end
                    )

                    task.wait()
                end

                task.wait(1.3)

                for k = 1, 1 do
                    for _, currentPlayer in ipairs(rows) do
                        destroyLineOnPlayer(currentPlayer.hrp)
                    end

                    task.wait(12)
                end

                stopLineLag()
                cost = false
            end
        )
    end
end

executeBlobmanKick = function()
    local spawnPosition = getKickTargets()
    if #spawnPosition == 0 then
        _NOTIFY("Kick Target: No targets found.", 3)
        return
    end
    _NOTIFY("Kick Target: Starting Blobman Kick V2 on " .. #spawnPosition .. " targets...", 3)

    task.spawn(
        function()
            local characterModel = playerInstance.Character or playerInstance.CharacterAdded:Wait()
            local columnIndex = characterModel:WaitForChild("HumanoidRootPart")
            local otherVector = rootGuiObject:FindFirstChild(playerInstance.Name .. "SpawnedInToys")

            if otherVector then
                local guiObject = otherVector:FindFirstChild("CreatureBlobman")

                if guiObject then
                    pcall(
                        function()
                            guiObject:Destroy()
                        end
                    )

                    task.wait(0.133)
                end
            end

            local rotationAngle = spawnBlobmanIfNeeded()
            if not rotationAngle then
                _NOTIFY("Kick Target: Failed to spawn Blobman.", 3)
                return
            end
            task.wait(0.1)
            sitOnBlobman(rotationAngle)
            task.wait(0.3)
            local batch = {}

            for _, projectile in ipairs(characterModel:GetDescendants()) do
                if projectile:IsA("BasePart") then
                    batch[projectile] = projectile.CanCollide
                    projectile.CanCollide = false
                end
            end

            grab = function(descendant, point)
                for _, member in ipairs({"Left", "Right"}) do
                    local refreshButton = descendant:FindFirstChild(member .. "Detector")
                    local existingPlayer = refreshButton and refreshButton:FindFirstChild(member .. "Weld")
                    local remoteEvent = descendant:FindFirstChild(
                        "BlobmanSeatAndOwnerScript"
                    )
                    remoteEvent = remoteEvent and remoteEvent:FindFirstChild(
                        "CreatureGrab"
                    )

                    if refreshButton and existingPlayer and remoteEvent then
                        pcall(
                            function()
                                remoteEvent:FireServer(refreshButton, point, existingPlayer)
                            end
                        )
                    end
                end
            end

            rere = function(descendant, point)
                for _, member in ipairs({"Left", "Right"}) do
                    local refreshButton = descendant:FindFirstChild(member .. "Detector")
                    local existingPlayer = refreshButton and refreshButton:FindFirstChild(member .. "Weld")
                    local remoteEvent = descendant:FindFirstChild(
                        "BlobmanSeatAndOwnerScript"
                    )
                    local middle = remoteEvent and remoteEvent:FindFirstChild(
                        "CreatureRelease"
                    )

                    if existingPlayer and middle then
                        pcall(
                            function()
                                middle:FireServer(existingPlayer, point)
                            end
                        )
                    end
                end
            end

            drop = function(descendant, point)
                for _, member in ipairs({"Left", "Right"}) do
                    local refreshButton = descendant:FindFirstChild(member .. "Detector")
                    local existingPlayer = refreshButton and refreshButton:FindFirstChild(member .. "Weld")
                    local remoteEvent = descendant:FindFirstChild(
                        "BlobmanSeatAndOwnerScript"
                    )
                    local PlayerGui = remoteEvent and remoteEvent:FindFirstChild(
                        "CreatureDrop"
                    )

                    if existingPlayer and PlayerGui then
                        pcall(
                            function()
                                PlayerGui:FireServer(existingPlayer, point)
                            end
                        )
                    end
                end
            end

            ungrab = function(descendant)
                local response = root:WaitForChild("GrabEvents"):FindFirstChild(
                    "DestroyGrabLine"
                )

                if descendant and response then
                    pcall(
                        function()
                            response:FireServer(descendant)
                        end
                    )
                end
            end

            local edgeList = {}

            for _, member in ipairs(spawnPosition) do
                local playerCharacter = member.Character
                playerCharacter = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")

                if playerCharacter then
                    table.insert(edgeList, {player = member, hrp = playerCharacter})
                end
            end

            for _, member in ipairs(edgeList) do
                pcall(
                    function()
                        columnIndex.CFrame = member.hrp.CFrame
                        columnIndex.AssemblyAngularVelocity = Vector3.zero
                    end
                )

                task.wait(0.11)

                if (columnIndex.Position - member.hrp.Position).Magnitude <= 35 then
                    for k = 1, 5 do
                        if not (not member.hrp.Parent or not rotationAngle.Parent) then
                            grab(rotationAngle, member.hrp)
                            task.wait()
                            rere(rotationAngle, member.hrp)
                            continue
                        end

                        break
                    end
                end
            end

            pcall(
                function()
                    columnIndex.CFrame = CFrame.new(0, 90, 0)
                    columnIndex.AssemblyLinearVelocity = Vector3.zero
                end
            )

            task.wait(0.2)
            columnIndex.Anchored = true
            local top = #edgeList

            for k, member in ipairs(edgeList) do
                local screenPosition = 6.2831853071795862 / top * (k - 1)
                local steer = Vector3.new(math.cos(screenPosition) * 22, 0, math.sin(screenPosition) * 22)

                pcall(
                    function()
                        member.hrp.CFrame = CFrame.new(
                            columnIndex.Position.X + steer.X, 90,
                            columnIndex.Position.Z + steer.Z
                        )
                        member.hrp.AssemblyLinearVelocity = Vector3.zero
                        member.hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                )
            end

            task.wait(0.2)
            local AppendEntriesEvent = root:WaitForChild("GrabEvents"):FindFirstChild(
                "SetNetworkOwner"
            )

            for _, member in ipairs(edgeList) do
                if AppendEntriesEvent then
                    for k = 1, 10 do
                        pcall(
                            function()
                                AppendEntriesEvent:FireServer(member.hrp, member.hrp.CFrame)
                            end
                        )
                    end
                end
            end

            task.wait(0.1)

            for _, member in ipairs(edgeList) do
                ungrab(member.hrp)
            end

            for _, member in ipairs(edgeList) do
                drop(rotationAngle, member.hrp)
            end

            columnIndex.Anchored = false
            local previousTime = os.clock()

            while os.clock() - previousTime < 0.05 do
                for _, member in ipairs(edgeList) do
                    task.spawn(
                        function()
                            if member.hrp.Parent and rotationAngle.Parent then
                                grab(rotationAngle, member.hrp)
                            end
                        end
                    )
                end

                task.wait()
            end

            for _, projectile in ipairs(characterModel:GetDescendants()) do
                if projectile:IsA("BasePart") and batch[projectile] ~= nil then
                    projectile.CanCollide = batch[projectile]
                end
            end

            _NOTIFY("Kick Target: Blobman Kick V2 execution complete.", 3)
        end
    )
end

