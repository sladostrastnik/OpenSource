    getTentSegmentPosition = function(descendant, point, object, v, deltaY, initialCapacity)
        local screenPosition = initialCapacity or 0
        local radians = point / top
        local nearestDistance = CFrame.Angles
        return (descendant * CFrame.new(screenPosition, 1, 3) * nearestDistance(
            math.rad(v * offsetZ * radians), math.rad(object * offsetZ * radians + index9 * radians),
            math.rad(deltaY * offsetZ * radians)
        ) * CFrame.new(0, index10 * point, 0)).Position
    end

    getTentSegmentCFrame = function(descendant, point, object, v, deltaY, initialCapacity)
        local spawnPosition = getTentSegmentPosition(descendant, point, object, v, deltaY, initialCapacity)
        local screenPosition

        if point < top then
            screenPosition = getTentSegmentPosition(descendant, point + 1, object, v, deltaY, initialCapacity) - spawnPosition
        else
            screenPosition = spawnPosition - getTentSegmentPosition(descendant, point - 1, object, v, deltaY, initialCapacity)
        end

        if screenPosition.Magnitude < 0.001 then
            return CFrame.new(spawnPosition)
        end
        local directionVector = screenPosition.Unit
        local otherVector = (Vector3.new(0, 1, 0)):Cross(directionVector)
        local steer = otherVector.Magnitude < 0.001 and Vector3.new(1, 0, 0) or otherVector.Unit
        return CFrame.fromMatrix(spawnPosition, steer, directionVector, -directionVector:Cross(steer).Unit)
    end

    calcStickToTarget = function(descendant, point, object)
        local directionVector = descendant:VectorToObjectSpace(point - (descendant * CFrame.new(object or 0, 1, 3)).Position).Unit
        return
            math.clamp(directionVector.X * 3, -3, 3), math.clamp(directionVector.Y * 3, -3, 3),
            math.clamp(-directionVector.Z * 3, -3, 3)
    end

