                            )
                        end

                        if otherVector.CloneFlags then
                            otherVector.CloneFlags.Position = UDim2.new(
                                0, rotationAngle.X + magnitude / 2 + 5, 0, rotationAngle.Y - total / 2
                            )
                            otherVector.CloneFlags.Size = UDim2.new(0, 150, 0, total)
                        end
                    else
                        otherVector.Gui.Enabled = false
                    end

                    noksApplyFadeTransparency(otherVector.Snapshot, radians)

                    if otherVector.CloneBox then
