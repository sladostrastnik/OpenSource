        onInputBegan(newPlayer)
        task.wait(2.3)
        initialize(newPlayer)
        task.wait(0.05)
        initialize(newPlayer)
        task.wait(0.3)
        return newPlayer
    end

    local function calculateDistance(descendant)
        if keys then
            keys:Disconnect()
            keys = nil
        end

        Character = descendant
        local player33 = descendant:FindFirstChild("HitboxPart")
        if not player33 then
            return
        end

        keys = runService.Heartbeat:Connect(
            function()
                if not sortedArray then
                    stopLoop()
                    return
                end

                if not Character or not Character.Parent then
                    return
                end
                local newPlayer = vectorLength()
                local first = false

                if newPlayer then
                    local seed = false

                    for _, newPart in pairs(newPlayer:GetChildren()) do
                        if newPart.Name == "FoodBanana" then
                            Character = newPart
                            player33 = newPart:FindFirstChild("HitboxPart")
                            seed = true
                            break
                        end
                    end

                    first = seed
                end

                if not first or not player33 then
                    keys:Disconnect()
                    keys = nil
                    Character = nil

                    if sortedArray then
                        task.wait(0.05)
                    end

                    return
                end

                local shooter = generateRandomPoints()
                if not shooter then
                    return
                end
                local top, nearestDistance

                if initializeSystem() <= 0 then
                    if not cost then
                        cost = true

                        if ray then
                            local playerUserId = PlayersService:FindFirstChild(ray)
                            grid.RagdollKillCounts = grid.RagdollKillCounts or {}
                            grid.RagdollKillCounts[ray] = (grid.RagdollKillCounts[ray] or 0) + 1

                            if _G.RagdollTargetCard then
                                _G.RagdollTargetCard:SetText(
                                    {"Total Kills: " .. tostring(grid.RagdollKillCounts[ray])}
                                )
                            end

                            if grid.RagdollKillNotify then
                                key:Notify(
                                    {
                                        Title = "Banana Ragdoll Kill",
                                        Description = (playerUserId and playerUserId.DisplayName or ray) .. " Died!\nCount: " .. tostring(
                                            grid.RagdollKillCounts[ray]
                                        ), Time = 5,
                                    }
                                )
                            end
                        end
                    end

                    top = shooter.CFrame * CFrame.new(0, 7, 0)
                    nearestDistance = CFrame.new(top.Position)
                else
                    cost = false
                    local playerUserId = serializeTable()

                    if playerUserId then
                        top = playerUserId.CFrame * CFrame.new(0, 0.5, 0)
                        nearestDistance = playerUserId.CFrame
                    else
                        top = shooter.CFrame * CFrame.new(0, 7, 0)
                        nearestDistance = CFrame.new(top.Position)
                    end
                end

                createVector(player33)
                generateUniqueIdentifier(player33)
                local RemoteEvent = player33:FindFirstChild("BodyPosition")

                if RemoteEvent then
                    RemoteEvent.Position = top.Position
                else
                    local controller = Instance.new("BodyPosition")
                    controller.P = 10000
                    controller.D = 100
                    controller.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                    controller.Position = top.Position
                    controller.Parent = player33
                end

                local bodyGyro = player33:FindFirstChild("BodyGyro")

                if bodyGyro then
                    bodyGyro.CFrame = nearestDistance
                else
                    local camera = Instance.new("BodyGyro")
                    camera.P = 10000
                    camera.D = 100
                    camera.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                    camera.CFrame = nearestDistance
                    camera.Parent = player33
                end
            end
        )
    end

    local function traverse()
        if sortedArray then
            return
        end

        if not ray or ray == "" then
            return
        end
        sortedArray = true
        cost = false
        local newPlayer = addVectors()

        if newPlayer then
            calculateDistance(newPlayer)
        end

        heartbeatConnection = runService.Heartbeat:Connect(
            function()
                if not sortedArray then
                    return
                end
                local shooter = vectorLength()
                local first = false

                if shooter then
                    for _, newPart in pairs(shooter:GetChildren()) do
                        if newPart.Name == "FoodBanana" then
                            first = true
                            break
                        end
                    end
                end

                if not first then
                    if keys then
                        keys:Disconnect()
                        keys = nil
                    end

                    task.wait(0.05)
                    local playerUserId = addVectors()

                    if playerUserId then
                        calculateDistance(playerUserId)
                    end
                end
            end
        )
    end

    local function clamp()
        sortedArray = false

        if keys then
            keys:Disconnect()
            keys = nil
        end

        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end

        if Character then
            createVector3(Character)
            local player33 = Character:FindFirstChild("HitboxPart")

            if player33 then
                local RemoteEvent = player33:FindFirstChild("BodyPosition")

                if RemoteEvent then
                    RemoteEvent:Destroy()
                end

                local bodyGyro = player33:FindFirstChild("BodyGyro")

                if bodyGyro then
                    bodyGyro:Destroy()
                end
            end

            Character = nil
        end

        local newPlayer = vectorLength()

        if newPlayer then
            for _, newPart in pairs(newPlayer:GetChildren()) do
                if newPart.Name == "FoodBanana" then
                    createVector3(newPart)
                end
            end
        end
    end

    local function cleanupResources()
        local bytes = {}

        for _, playerObject in ipairs(PlayersService:GetPlayers()) do
            if playerObject ~= playerInstance then
                table.insert(bytes, playerObject.DisplayName .. " (" .. playerObject.Name .. ")")
            end
        end

        return bytes
    end

    local function normalizeVector(descendant)
        if not descendant or descendant == "" then
            return nil
        end
        local newPlayer = string.find(descendant, "%(")
        if newPlayer then
            return string.sub(descendant, newPlayer + 1, -2)
        end
        return nil
    end

    local humanoidRootPart = packed:AddDropdown(
        "TargetSelect",
        {
            Text = "Select Player", Default = "", Values = cleanupResources(),
            Callback = function(descendant)
                local newPlayer = normalizeVector(descendant)

                if newPlayer then
                    ray = newPlayer

                    if _G.RagdollTargetCard then
                        _G.RagdollTargetCard:NewTarget(newPlayer)
                        grid.RagdollKillCounts = grid.RagdollKillCounts or {}
                        _G.RagdollTargetCard:SetText(
                            {"Total Kills: " .. tostring(grid.RagdollKillCounts[newPlayer] or 0)}
                        )
                    end
                else
                    ray = nil
                end
            end,
        }
    )

    local function runSimulation()
        if humanoidRootPart then
            humanoidRootPart:SetValues(cleanupResources())
        end
    end

    PlayersService.PlayerAdded:Connect(
        function()
            task.wait(0.5)
            runSimulation()
        end
    )

    PlayersService.PlayerRemoving:Connect(
        function()
            task.wait(0.2)
            runSimulation()
        end
    )

    task.spawn(
        function()
            task.wait(1)
            runSimulation()
        end
    )

    packed:AddToggle(
        "RagdollKill",
        {
            Text = "Ragdoll Kill", Default = false,
            Callback = function(descendant)
                if descendant then
                    if not ray or ray == "" then
                        return
                    end
                    changed = true
                    coroutineFunction()
                    createClass()
                    thread = task.spawn(deepCopyTable)
                else
                    changed = false

                    if thread then
                        task.cancel(thread)
                        thread = nil
                    end

                    vectorAdd()
                end
            end,
        }
    )

    placeholder = packed:AddToggle(
        "LoopBananaRagdoll",
        {
            Text = "Banana Ragdoll", Default = false,
            Callback = function(descendant)
                if descendant then
                    if not ray or ray == "" then
                        placeholder:Set(false)
                        return
                    end
                    clamp()
                    traverse()
                else
                    clamp()
                end
            end,
        }
    )
end
