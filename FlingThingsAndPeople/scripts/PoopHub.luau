local openSet = {}

lcUpsert = function(descendant, player93, point)
    local Workspace = game:GetService("Lighting")

    if openSet[player93] then
        pcall(
            function()
                openSet[player93]:Destroy()
            end
        )
    end

    local heap = Instance.new(descendant)
    heap.Name = player93

    for prefix, rainParticle in pairs(point) do
        pcall(
            function()
                heap[prefix] = rainParticle
            end
        )
    end

    heap.Parent = Workspace
    openSet[player93] = heap
    return heap
end

