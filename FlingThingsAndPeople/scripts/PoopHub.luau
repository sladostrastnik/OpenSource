    _G.kickNotifyConnection = nil

    getClosestPlayerKN = function(descendant)
        local minX = math.huge
        local minutes = nil

        for _, playerObject in pairs(PLAYERS:GetPlayers()) do
            if playerObject.Character then
                local columnIndex = playerObject.Character:FindFirstChild("HumanoidRootPart")

                if columnIndex then
                    local rightIndex = (columnIndex.Position - descendant).Magnitude

                    if rightIndex < minX then
                        minX = rightIndex
                        minutes = playerObject
                    end
                end
            end
        end

        return minutes
    end

    KickNotify = function(descendant, point)
        local minutes = dataTable[grid.selectedNotificationSound]
        if not minutes then
            return
        end

        pcall(
            function()
                if not grid.notificationSoundEnabled then
                    return
                end
                local soundInstance = Instance.new("Sound")
                soundInstance.SoundId = minutes
                soundInstance.Volume = 1
                soundInstance.Parent = game:GetService("SoundService")
                soundInstance:Play()

                soundInstance.Ended:Connect(
                    function()
                        soundInstance:Destroy()
                    end
                )
            end
        )

        _NOTIFY(descendant, point)
    end

    HttpService:AddToggle(
        "KickNotify",
        {
            Text = "Kick Notify", Default = false,
            Callback = function(descendant)
                if descendant then
                    local openSet = {
                        blackholekick = true, ["blackholekicktweens(old)"] = true,
                        blackholekicktweens = true, jhole = true, blackhole = true,
                        black_hole = true, voidhole = true, singularity = true,
                    }

                    _G.kickNotifyConnection = workspace.ChildAdded:Connect(
                        function(sound)
                            if not sound.Name or not openSet[sound.Name:lower()] then
                                return
                            end
                            task.wait(0.1)
                            local screenSize

                            if sound:IsA("BasePart") then
                                screenSize = sound.Position
                            else
                                local targetPart = sound:FindFirstChildWhichIsA("BasePart", true)
                                screenSize = nil

                                if targetPart then
                                    screenSize = targetPart.Position
                                end
                            end

                            if not screenSize then
                                return
                            end
                            local minutes = getClosestPlayerKN(screenSize)
                            local content = minutes and " by " .. minutes.Name or ""
                            _NOTIFY("Kick Notify: Kick detected" .. content, 4)
                            KickNotify("Kick Notify: Kick detected" .. content, 4)
                        end
                    )

                    _NOTIFY("Kick Notify: Enabled", 2)
                else
                    if _G.kickNotifyConnection then
                        _G.kickNotifyConnection:Disconnect()
                        _G.kickNotifyConnection = nil
                    end

                    _NOTIFY("Kick Notify: Disabled", 2)
                end
            end,
        }
    )
end

