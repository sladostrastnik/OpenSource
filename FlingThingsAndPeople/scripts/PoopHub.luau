executeSequenceGucci = function(elevatorModel)
    if elevatorModel.Name ~= grid.targetToyName then
        return
    end
    grid.currentInstance = elevatorModel
    local EquipmentSlot, lower, spawnPosition = getCharInfo()
    if not (lower and spawnPosition) then
        return
    end
    local terrain = elevatorModel:WaitForChild("VehicleSeat", 2) or elevatorModel:FindFirstChildWhichIsA(
        "VehicleSeat", true
    )

    if terrain and spawnPosition then
        pcall(
            function()
                terrain:Sit(spawnPosition)
            end
        )

        local previousTime = tick()

        while true do
            local right = result41.ANTI_DURATION

            if tick() - previousTime < right and grid.autoRunEnabled then
                pcall(
                    function()
                        fireEvent:FireServer(lower, 0)
                        spawnPosition:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                )

                runService.Heartbeat:Wait()
                continue
            end

            break
        end

        local linearVelocity = elevatorModel.PrimaryPart or elevatorModel:FindFirstChild(
            "HumanoidRootPart", true
        ) or elevatorModel:FindFirstChild("Part", true)

        if linearVelocity and grid.autoRunEnabled then
            pcall(
                function()
                    if linearVelocity.SetNetworkOwner then
                        linearVelocity:SetNetworkOwner(playerInstance)
                    end

                    sethiddenproperty(linearVelocity, "NetworkIsSleeping", false)
                end
            )
        end

        if grid.originalPos then
            lower.CFrame = grid.originalPos
        end

        task.wait(0.1)

        if terrain then
            terrain:Destroy()
        end
    end
end

