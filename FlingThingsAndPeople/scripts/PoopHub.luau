runTargetKillAura = function(descendant)
    while grid.targetKillRunning and grid.selectedTargetPlayer == descendant do
        task.wait(0.01)
        local EquipmentSlot, lower = getCharInfo()

        if lower then
            local spawnPosition = PLAYERS:FindFirstChild(descendant)

            if not spawnPosition or not spawnPosition.Character then
                task.wait(1)
            else
                local characterModel = spawnPosition.Character
                local columnIndex = characterModel:FindFirstChild("HumanoidRootPart")
                local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")

                if not (columnIndex and targetHumanoid) or targetHumanoid.Health <= 0 then
                    task.wait(1)
                else
                    local otherVector = spawnBlobmanIfNeeded()

                    if not otherVector then
                        task.wait(0.5)
                    else
                        local terrain = otherVector:FindFirstChildWhichIsA("VehicleSeat", true)
                        local hum = EquipmentSlot and EquipmentSlot:FindFirstChildOfClass("Humanoid")

                        if not (terrain and hum) then
                            task.wait(0.5)
                        else
                            if not terrain.Occupant then
                                pcall(
                                    function()
                                        terrain:Sit(hum)
                                    end
                                )

                                task.wait(0.2)
                            end

                            if not terrain.Occupant then
                                task.wait(0.5)
                            else
                                local remoteEvent = otherVector:FindFirstChild(
                                    "BlobmanSeatAndOwnerScript"
                                )
                                local encoded = otherVector:FindFirstChild("LeftDetector")
                                local encryptedPayload = encoded and encoded:FindFirstChild(
                                    "LeftWeld"
                                )

                                if not (remoteEvent and encoded and encryptedPayload) then
                                    task.wait(0.5)
                                else
                                    local intersect = remoteEvent:FindFirstChild(
                                        "CreatureGrab"
                                    )
                                    local middle = remoteEvent:FindFirstChild(
                                        "CreatureRelease"
                                    )
                                    local PlayerGui = remoteEvent:FindFirstChild(
                                        "CreatureDrop"
                                    )

                                    if not (intersect and middle and PlayerGui) then
                                        task.wait(0.5)
                                    else
                                        grid.lastTargetPosition = lower.CFrame

                                        pcall(
                                            function()
                                                lower.CFrame = columnIndex.CFrame * CFrame.new(
                                                    0, 0, -3
                                                )
                                            end
                                        )

                                        task.wait(0.2)
                                        local previousTime = tick()

                                        while true do
                                            if tick() - previousTime < 2 and grid.targetKillRunning then
                                                if spawnPosition and spawnPosition.Character and targetHumanoid.Health > 0 then
                                                    if terrain.Occupant then
                                                        if (lower.Position - columnIndex.Position).Magnitude <= 30 then
                                                            pcall(
                                                                function()
                                                                    intersect:FireServer(
                                                                        encoded,
                                                                        columnIndex, encryptedPayload
                                                                    )
                                                                    middle:FireServer(
                                                                        encryptedPayload, columnIndex
                                                                    )
                                                                    PlayerGui:FireServer(
                                                                        encryptedPayload, columnIndex
                                                                    )
                                                                    targetHumanoid.Health = 0
                                                                end
                                                            )
                                                        end

                                                        task.wait(0.01)
                                                        continue
                                                    end
                                                end
                                            end

                                            break
                                        end

                                        task.wait(0.1)

                                        if grid.lastTargetPosition then
                                            pcall(
                                                function()
                                                    lower.CFrame = grid.lastTargetPosition
                                                end
                                            )
                                        end

                                        if targetHumanoid.Health <= 0 then
                                            local active = false
                                            local connection = nil

                                            connection = descendant and PLAYERS:FindFirstChild(descendant) and PLAYERS:FindFirstChild(
                                                descendant
                                            ).CharacterAdded:Connect(
                                                function()
                                                    active = true

                                                    if connection then
                                                        connection:Disconnect()
                                                    end
                                                end
                                            )

                                            local currentTimestamp = tick()

                                            while not active and grid.targetKillRunning and tick() - currentTimestamp < 30 do
                                                task.wait()
                                            end

                                            if connection then
                                                pcall(
                                                    function()
                                                        connection:Disconnect()
                                                    end
                                                )
                                            end

                                            task.wait(0.05)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

