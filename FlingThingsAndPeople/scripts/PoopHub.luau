LoopKickBlobFunction = function(descendant)
    local newRoot = root:WaitForChild("GrabEvents")
    local characterModel = playerInstance.Character or playerInstance.CharacterAdded:Wait()
    local partInstance = characterModel:WaitForChild("Humanoid").SeatPart

    if not partInstance or partInstance.Parent.Name ~= "CreatureBlobman" then
        _NOTIFY("Loop Kick: Please ride Blobman first", 3)
        grid.loopKickBlobActive = false
        return
    end

    local npcModel = partInstance.Parent
    local columnIndex = npcModel:FindFirstChild("HumanoidRootPart") or npcModel.PrimaryPart
    local remoteEvent = npcModel:WaitForChild("BlobmanSeatAndOwnerScript")
    local intersect = remoteEvent:WaitForChild("CreatureGrab")
    local PlayerGui = remoteEvent:WaitForChild("CreatureDrop")
    local clonedModel = npcModel:WaitForChild("RightDetector")
    local nearestDistance = CFrame.new(20000, 20000, 20000)

    if grid.loopKickBlobMode == "TP to Sky" then
        ensureSkyKickFloor()
        local Graph = CFrame.new(20000, 20010.5, 20000)

        pcall(
            function()
                columnIndex.CFrame = Graph
            end
        )

        local raycastResult = characterModel:FindFirstChild("HumanoidRootPart")

        if raycastResult then
            pcall(
                function()
                    raycastResult.CFrame = Graph
                end
            )
        end

        task.wait(0.2)
        nearestDistance = Graph
    end

    local currentCFrame = grid.loopKickBlobMode == "TP to Sky" and nearestDistance or columnIndex.CFrame
    local active = false
    local elapsedTime = 0
    local columnCount = 0

    while grid.loopKickBlobActive do
        local lower = PLAYERS:FindFirstChild(descendant)

        if lower then
            local playerCharacter = playerInstance.Character
            local targetHumanoid = playerCharacter and playerCharacter:FindFirstChild("Humanoid")
            local player206 = targetHumanoid and targetHumanoid.SeatPart

            if not (not player206 or player206.Parent.Name ~= "CreatureBlobman") then
                local vehicleModel = player206.Parent
                columnIndex = vehicleModel:FindFirstChild("HumanoidRootPart") or vehicleModel.PrimaryPart
                local expectedType = lower.Character
                local raycastResult = expectedType and expectedType:FindFirstChild(
                    "HumanoidRootPart"
                )
                local hum = expectedType and expectedType:FindFirstChild("Humanoid")

                if raycastResult and hum and hum.Health > 0 and columnIndex then
                    raycastResult.Velocity = Vector3.zero

                    if not active then
                        columnIndex.CFrame = raycastResult.CFrame
                        columnIndex.Velocity = Vector3.zero

                        if tick() - elapsedTime >= 0.002 then
                            elapsedTime = tick()

                            pcall(
                                function()
                                    hum.PlatformStand = true
                                    hum.Sit = true
                                    newRoot.SetNetworkOwner:FireServer(
                                        raycastResult, columnIndex.CFrame
                                    )
                                    newRoot.DestroyGrabLine:FireServer(raycastResult)
                                end
                            )
                        end

                        if columnCount == 0 then
                            columnCount = tick()
                        end

                        if tick() - columnCount > 0.35 then
                            columnIndex.CFrame = currentCFrame
                            columnIndex.Velocity = Vector3.zero
                            active = true
                            columnCount = 0
                        end
                    else
                        columnIndex.CFrame = currentCFrame
                        columnIndex.Velocity = Vector3.zero
                        local offsetY = currentCFrame * CFrame.new(0, 23, 0)
                        raycastResult.CFrame = offsetY
                        hum.PlatformStand = true
                        hum.Sit = true

                        if tick() - elapsedTime >= 0.002 then
                            elapsedTime = tick()

                            pcall(
                                function()
                                    newRoot.SetNetworkOwner:FireServer(
                                        raycastResult, offsetY
                                    )
                                    newRoot.DestroyGrabLine:FireServer(raycastResult)
                                    local option = clonedModel:FindFirstChild("RightWeld") or clonedModel:FindFirstChildWhichIsA(
                                        "Weld"
                                    )

                                    if option then
                                        PlayerGui:FireServer(option)
                                        intersect:FireServer(
                                            clonedModel, raycastResult, option
                                        )
                                    end
                                end
                            )
                        end
                    end
                else
                    active = false
                    columnCount = 0
                end

                runService.Heartbeat:Wait()
                continue
            end
        end

        break
    end

    if columnIndex then
        columnIndex.CFrame = currentCFrame
        columnIndex.Velocity = Vector3.zero
    end

    if grid.loopKickBlobMode == "TP to Sky" then
        removeSkyKickFloor()
    end
end

