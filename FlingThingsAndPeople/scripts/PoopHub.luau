                    for _, hitbox in ipairs({"Left", "Right"}) do
                        local randomYaw = descendant:FindFirstChild(hitbox .. "Detector")
                        local refreshButton = randomYaw and randomYaw:FindFirstChild(hitbox .. "Weld")
                        local remoteEvent = descendant:FindFirstChild(
                            "BlobmanSeatAndOwnerScript"
                        )
                        local intersect = remoteEvent and remoteEvent:FindFirstChild(
                            "CreatureGrab"
                        )

                        if randomYaw and refreshButton and intersect then
                            pcall(
                                function()
                                    intersect:FireServer(randomYaw, point, refreshButton)
                                end
                            )
                        end
                    end
                end

                bkRere = function(descendant, point)
                    if not descendant or not descendant.Parent then
                        return
                    end

                    for _, hitbox in ipairs({"Left", "Right"}) do
                        local randomYaw = descendant:FindFirstChild(hitbox .. "Detector")
                        local refreshButton = randomYaw and randomYaw:FindFirstChild(hitbox .. "Weld")
                        local remoteEvent = descendant:FindFirstChild(
                            "BlobmanSeatAndOwnerScript"
                        )
                        local middle = remoteEvent and remoteEvent:FindFirstChild(
                            "CreatureRelease"
                        )

                        if refreshButton and middle then
                            pcall(
                                function()
                                    middle:FireServer(refreshButton, point)
                                end
                            )
                        end
                    end
                end

                bkDrop = function(descendant, point)
                    if not descendant or not descendant.Parent then
                        return
                    end

                    for _, hitbox in ipairs({"Left", "Right"}) do
                        local randomYaw = descendant:FindFirstChild(hitbox .. "Detector")
                        local refreshButton = randomYaw and randomYaw:FindFirstChild(hitbox .. "Weld")
                        local remoteEvent = descendant:FindFirstChild(
                            "BlobmanSeatAndOwnerScript"
                        )
                        local PlayerGui = remoteEvent and remoteEvent:FindFirstChild(
                            "CreatureDrop"
                        )

                        if refreshButton and PlayerGui then
                            pcall(
                                function()
                                    PlayerGui:FireServer(refreshButton, point)
                                end
                            )
                        end
                    end
                end

                local hitHumanoid = root:WaitForChild("GrabEvents")

                bkUngrab = function(descendant)
                    local response = hitHumanoid:FindFirstChild("DestroyGrabLine")

                    if descendant and response then
                        pcall(
                            function()
                                response:FireServer(descendant)
                            end
                        )
                    end
                end

                _NOTIFY("GatherKickAll: Gathering...", 3)
                local AppendEntriesEvent = hitHumanoid:FindFirstChild("SetNetworkOwner")

                for _, hitbox in ipairs(edgeList) do
                    if sortedArray then
                        pcall(
                            function()
                                columnIndex.CFrame = hitbox.hrp.CFrame
                                columnIndex.AssemblyAngularVelocity = Vector3.zero
                            end
                        )

                        task.wait(0.11)

                        if AppendEntriesEvent and hitbox.hrp and hitbox.hrp.Parent then
                            for k = 1, 8 do
                                pcall(
                                    function()
                                        AppendEntriesEvent:FireServer(hitbox.hrp, hitbox.hrp.CFrame)
                                    end
                                )
                            end
                        end

                        if (columnIndex.Position - hitbox.hrp.Position).Magnitude <= 35 then
                            for k = 1, 5 do
                                if not (not hitbox.hrp.Parent or not otherVector.Parent) then
                                    bkGrab(otherVector, hitbox.hrp)
                                    task.wait()
                                    bkRere(otherVector, hitbox.hrp)
                                    continue
                                end

                                break
                            end
                        end

                        if AppendEntriesEvent and hitbox.hrp and hitbox.hrp.Parent then
                            for k = 1, 4 do
                                pcall(
                                    function()
                                        AppendEntriesEvent:FireServer(hitbox.hrp, hitbox.hrp.CFrame)
                                    end
                                )
                            end
                        end

                        continue
                    end

                    break
                end

                local index4 = grid.gkaCenterY or 50
                local index5 = grid.gkaCircleRadius or 6
                local screenPosition = #edgeList

                pcall(
                    function()
                        columnIndex.CFrame = CFrame.new(0, index4, 0)
                        columnIndex.AssemblyLinearVelocity = Vector3.zero
                    end
                )

                task.wait(0.2)
                columnIndex.Anchored = true

                for k, hitbox in ipairs(edgeList) do
                    local radians = 6.2831853071795862 / screenPosition * (k - 1)
                    local steer = Vector3.new(
                        math.cos(radians) * index5, 0, math.sin(radians) * index5
                    )

                    pcall(
                        function()
                            hitbox.hrp.CFrame = CFrame.new(
                                columnIndex.Position.X + steer.X, index4,
                                columnIndex.Position.Z + steer.Z
                            )
                            hitbox.hrp.AssemblyLinearVelocity = Vector3.zero
                            hitbox.hrp.AssemblyAngularVelocity = Vector3.zero
                        end
                    )
                end

                task.wait(0.2)
                local ArcRemoteEvent = hitHumanoid:FindFirstChild("SetNetworkOwner")

                for _, hitbox in ipairs(edgeList) do
                    if ArcRemoteEvent and hitbox.hrp and hitbox.hrp.Parent then
                        for k = 1, 10 do
                            pcall(
                                function()
                                    ArcRemoteEvent:FireServer(hitbox.hrp, hitbox.hrp.CFrame)
                                end
                            )
                        end
                    end
                end

                task.wait(0.1)

                for _, hitbox in ipairs(edgeList) do
                    bkUngrab(hitbox.hrp)
                end

                for _, hitbox in ipairs(edgeList) do
                    bkDrop(otherVector, hitbox.hrp)
                end

                columnIndex.Anchored = false
                local previousTime = os.clock()

                while os.clock() - previousTime < 0.05 do
                    for _, hitbox in ipairs(edgeList) do
                        task.spawn(
                            function()
                                if hitbox.hrp and hitbox.hrp.Parent and otherVector and otherVector.Parent then
                                    bkGrab(otherVector, hitbox.hrp)
                                end
                            end
                        )
                    end

                    task.wait()
                end

                for _, projectile in ipairs(characterModel:GetDescendants()) do
                    if projectile:IsA("BasePart") and rows[projectile] ~= nil then
                        projectile.CanCollide = rows[projectile]
                    end
                end

                _NOTIFY("GatherKickAll: Orbit starting!", 3)
                local index2 = grid.gkaBlobRotateRadius or 18

                if not otherVector.Parent then
                    _NOTIFY("GatherKickAll: Re-spawning Blobman...", 2)

                    pcall(
                        function()
                            columnIndex.CFrame = CFrame.new(
                                0, index4 + 3, index2
                            )
                            columnIndex.AssemblyLinearVelocity = Vector3.zero
                        end
                    )

                    task.wait(0.2)
                    otherVector = spawnBlobmanIfNeeded()

                    if not otherVector then
                        _NOTIFY("GatherKickAll: Blobman spawn failed, orbit aborted!", 3)
                        gkaStop()
                        return
                    end

                    sitOnBlobman(otherVector)
                    task.wait(0.35)
                else
                    local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")

                    if not (targetHumanoid and targetHumanoid.SeatPart) then
                        pcall(
                            function()
                                columnIndex.CFrame = CFrame.new(
                                    0, index4 + 3, index2
                                )
                                columnIndex.AssemblyLinearVelocity = Vector3.zero
                            end
                        )

                        task.wait(0.2)
                        sitOnBlobman(otherVector)
                        task.wait(0.35)
                    else
                        pcall(
                            function()
                                columnIndex.CFrame = CFrame.new(
                                    0, index4 + 3, index2
                                )
                                columnIndex.AssemblyLinearVelocity = Vector3.zero
                            end
                        )

                        task.wait(0.15)
                    end
                end

                local openSet = {}

                for k, hitbox in ipairs(edgeList) do
                    if hitbox.hrp and hitbox.hrp.Parent then
                        local radians = 6.2831853071795862 / screenPosition * (k - 1)
                        local difference = math.cos(radians) * index5
                        local rowCount = math.sin(radians) * index5

                        pcall(
                            function()
                                hitbox.hrp.CFrame = CFrame.new(difference, index4, rowCount)
                                hitbox.hrp.AssemblyLinearVelocity = Vector3.zero
                            end
                        )

                        local RemoteEvent = Instance.new("BodyPosition")
                        RemoteEvent.MaxForce = Vector3.new(4e9, 5e9, 4e9)
                        RemoteEvent.P = 100000000
                        RemoteEvent.D = 10000
                        RemoteEvent.Position = Vector3.new(difference, index4, rowCount)
                        RemoteEvent.Parent = hitbox.hrp
                        table.insert(openSet, RemoteEvent)
                    end
                end

                batch = edgeList
                top = 0

                task.delay(
                    8,
                    function()
                        for _, hitbox in ipairs(openSet) do
                            pcall(
                                function()
                                    hitbox:Destroy()
                                end
                            )
                        end
                    end
                )

                local radians = 0
                local difference = 0
                local index3 = grid.gkaBlobRotateSpeed or 4

                keys = runService.RenderStepped:Connect(
                    function(alpha)
                        if not sortedArray then
                            pcall(
                                function()
                                    keys:Disconnect()
                                end
                            )

                            keys = nil
                            return
                        end

                        if not otherVector or not otherVector.Parent then
                            return
                        end
                        radians -= alpha

                        if radians <= 0 then
                            radians = 0.5
                            local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")

                            if not (targetHumanoid and targetHumanoid.SeatPart) then
                                task.spawn(
                                    function()
                                        sitOnBlobman(otherVector)
                                    end
                                )
                            end
                        end

                        difference -= alpha

                        if difference <= 0 then
                            difference = 3
                            local cost = false

                            for _, hitbox in ipairs(batch) do
                                if hitbox.player and hitbox.player.Parent then
                                    cost = true
                                    break
                                end
                            end

                            if not cost then
                                _NOTIFY("GatherKickAll: All targets gone, stopping.", 3)
                                task.spawn(gkaStop)
                                return
                            end

                            pcall(
                                function()
                                    _G.kt_startLineLag()
                                end
                            )
                        end

                        top += index3 * alpha
                        local rowCount = math.cos(top) * index2
                        local leftChild = math.sin(top) * index2
                        local raycastResult = otherVector:FindFirstChild("HumanoidRootPart") or otherVector:FindFirstChildWhichIsA(
                            "BasePart", true
                        )

                        if raycastResult then
                            pcall(
                                function()
                                    local screenSize = raycastResult.Position
                                    raycastResult.AssemblyLinearVelocity = (Vector3.new(
                                        rowCount, index4 + 2, leftChild
                                    ) - screenSize) * 60
                                    raycastResult.CFrame = CFrame.new(
                                        raycastResult.Position
                                    ) * CFrame.Angles(0, -(top + 1.5707963267948966), 0)
                                end
                            )
                        end

                        local maximumValue = #batch

                        if maximumValue > 0 then
                            local rotationAngle = batch[math.random(1, maximumValue)]

                            if rotationAngle and rotationAngle.hrp and rotationAngle.hrp.Parent then
                                task.spawn(
                                    function()
                                        bkGrab(otherVector, rotationAngle.hrp)
                                    end
                                )
                            end

                            for k, member in ipairs(batch) do
                                local bullet = member.hrp

                                if bullet and bullet.Parent then
                                    local angleRadians = 6.2831853071795862 / maximumValue * (k - 1)

                                    pcall(
                                        function()
                                            bullet.CFrame = CFrame.new(
                                                math.cos(angleRadians) * index5, index4,
                                                math.sin(angleRadians) * index5
                                            )
                                            bullet.AssemblyLinearVelocity = Vector3.zero
                                        end
                                    )
                                end
                            end
                        end
                    end
                )
            end
        )
    end
end

