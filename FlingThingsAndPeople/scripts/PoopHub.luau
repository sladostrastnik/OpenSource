    getTriggerTarget = function()
        if content == "All Players" then
            local now = game:GetService("UserInputService"):GetMouseLocation()
            local screenPosition = 150
            local columnIndex = nil

            for _, playerObject in ipairs(game.Players:GetPlayers()) do
                if playerObject ~= PLAYER and playerObject.Character and playerObject.Character:FindFirstChild(
                    "HumanoidRootPart"
                ) then
                    local targetHumanoid = playerObject.Character:FindFirstChildOfClass("Humanoid")

                    if targetHumanoid and targetHumanoid.Health > 0 then
                        local jsonString, theta = Camera:WorldToViewportPoint(
                            playerObject.Character.HumanoidRootPart.Position
                        )

                        if theta then
                            local rightIndex = (Vector2.new(jsonString.X, jsonString.Y) - now).Magnitude

                            if rightIndex < screenPosition then
                                columnIndex = playerObject.Character.HumanoidRootPart
                                screenPosition = rightIndex
