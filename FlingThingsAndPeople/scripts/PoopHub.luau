                x = v.x + spawnPosition.x - otherVector.x, y = v.y + spawnPosition.y - otherVector.y, z = v.z + spawnPosition.z - otherVector.z,
                rx = v.rx + spawnPosition.rx - otherVector.rx, ry = v.ry + spawnPosition.ry - otherVector.ry,
                rz = v.rz + spawnPosition.rz - otherVector.rz,
            }
        )
    end

    stopProps = function()
        _G.PropsActive = false

        for _, definition in ipairs(playerList) do
            pcall(
                function()
                    definition:Disconnect()
                end
            )
        end

        playerList = {}
        batch = {}
    end

    startProps = function()
        stopProps()
        _G.PropsActive = true
        local columnIndex = (playerInstance.Character or playerInstance.CharacterAdded:Wait()):WaitForChild(
            "HumanoidRootPart"
        )
        local cost = fileName ~= "My Toys"
        local targetPlayerName = fileName:gsub(" ", "")
        local currentInstance = rootGuiObject:FindFirstChild(playerInstance.Name .. "SpawnedInToys") or rootGuiObject:WaitForChild(
            playerInstance.Name .. "SpawnedInToys", 10
        )
        if not currentInstance then
            return
        end
        local offset = root.MenuToys:FindFirstChild("DestroyToy")

        for _, newPart in ipairs(currentInstance:GetChildren()) do
            for _, definition in ipairs(edgeList) do
                if newPart.Name == definition.name then
                    pcall(
                        function()
                            if offset then
                                offset:FireServer(newPart)
                            end
                        end
                    )

                    task.wait(0.05)
                    break
                end
            end
        end

        task.wait(0.3)
        local leftChild = columnIndex.CFrame * CFrame.new(0, 0, -3)

        for _, definition in ipairs(edgeList) do
            for k = 1, definition.count do
                pcall(
                    function()
                        BuoyancyRemoteFunction:InvokeServer(definition.name, leftChild, Vector3.zero)
                    end
                )

                task.wait(0.15)
            end
        end

        task.wait(0.4)

        if cost then
            currentInstance = rootGuiObject:FindFirstChild("PlotItems")
            currentInstance = currentInstance and currentInstance:FindFirstChild(targetPlayerName)

            if not currentInstance then
                task.wait(1)
                currentInstance = rootGuiObject:FindFirstChild("PlotItems")
                currentInstance = currentInstance and currentInstance:FindFirstChild(targetPlayerName)
            end
        end

        if not currentInstance then
            return
        end
        local previousTime = tick()
        local emitterInstance = {}

        for k = 1, rowCount do
            for _, newPart in ipairs(currentInstance:GetChildren()) do
                if newPart.Name == openSet[k].name then
                    local changed = false

                    for _, definition in ipairs(emitterInstance) do
                        definition = definition and definition.model == newPart
                        if definition then
                            changed = true
                            break
                        end
                    end

                    if not changed then
                        local spawnPosition = propGetPart(openSet[k].name, newPart)
                        if spawnPosition then
                            emitterInstance[k] = {part = spawnPosition, model = newPart}
                            break
                        end
                    end
                end
            end
        end

        for k = 1, rowCount do
            local spawnPosition = emitterInstance[k]

            if spawnPosition then
                pcall(
                    function()
                        for _, projectile in ipairs(spawnPosition.model:GetDescendants()) do
                            if projectile:IsA("BasePart") then
                                projectile.CanCollide = false
                                projectile.CanTouch = false
                            end
                        end
                    end
                )

                local currentCFrame = columnIndex.CFrame * propToCF(openSet[k])

                if cost then
                    pcall(
                        function()
                            AntiCheatEvent:FireServer(spawnPosition.part, spawnPosition.part.CFrame)
                            task.wait(0.05)
                            spawnPosition.part.CFrame = currentCFrame
                            spawnPosition.part.AssemblyLinearVelocity = Vector3.zero
                            spawnPosition.part.AssemblyAngularVelocity = Vector3.zero
                            AntiCheatEvent:FireServer(spawnPosition.part, currentCFrame)
                        end
                    )
                else
                    propClaimAndMove(spawnPosition.part, currentCFrame)
                end

                local RemoteEvent = Instance.new("BodyPosition")
                RemoteEvent.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                RemoteEvent.P = 50000
                RemoteEvent.D = 1000
                RemoteEvent.Position = currentCFrame.Position
                RemoteEvent.Parent = spawnPosition.part
                local bodyGyro = Instance.new("BodyGyro")
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.P = 50000
                bodyGyro.D = 1000
                bodyGyro.CFrame = currentCFrame
                bodyGyro.Parent = spawnPosition.part
                table.insert(
                    batch,
                    {part = spawnPosition.part, model = spawnPosition.model, gi = k, bp = RemoteEvent, bg = bodyGyro}
                )
            end
        end

        table.insert(
            playerList,
            runService.Heartbeat:Connect(
                function(alpha)
                    if not _G.PropsActive then
                        return
                    end
                    local characterModel = playerInstance.Character
                    characterModel = characterModel and characterModel:FindFirstChild("HumanoidRootPart")
                    if not characterModel then
                        return
                    end
                    local maximumValue = tick() - previousTime
                    local changed = not cost or maximumValue < 5
                    local spawnPosition = propGetWalkState(characterModel)
                    local otherVector = propIsMoving(characterModel)

                    if content == "Walk" then
                        if otherVector then
                            top += screenPosition * radians * alpha

                            if top >= 1 then
                                top = 1
                                screenPosition = -1
                            elseif top <= 0 then
                                top = 0
                                screenPosition = 1
                            end
                        else
                            top = 0
                            screenPosition = 1
                        end
                    end

                    for _, hitbox in ipairs(batch) do
                        if hitbox.part and hitbox.part.Parent then
                            local randomYaw = propGetTargetCF(hitbox.gi, characterModel, spawnPosition, otherVector)

                            if changed then
                                pcall(
                                    function()
                                        AntiCheatEvent:FireServer(hitbox.part, randomYaw)
                                    end
                                )
                            end

                            hitbox.bp.Position = randomYaw.Position
                            hitbox.bg.CFrame = randomYaw
                        end
                    end
                end
            )
        )
    end

    propToJSON = function()
        local emitterInstance = {}

        for k = 1, rowCount do
            local spawnPosition = openSet[k]
            table.insert(
                emitterInstance,
                string.format(
                    "  {\"name\":\"%s\",\"index\":%d,\"x\":%g,\"y\":%g,\"z\":%g,\"rx\":%g,\"ry\":%g,\"rz\":%g}",
                    spawnPosition.name, spawnPosition.localIndex, spawnPosition.x, spawnPosition.y, spawnPosition.z, spawnPosition.rx, spawnPosition.ry, spawnPosition.rz
                )
            )
        end

        return "[\n" .. table.concat(emitterInstance, ",\n") .. "\n]"
    end

    _G.prop_startProps = startProps
    _G.prop_stopProps = stopProps
    _G.prop_toJSON = propToJSON

    _G.prop_setMode = function(descendant)
        content = descendant
        top = 0
        screenPosition = 1
    end

    _G.prop_setAnimSpeed = function(descendant)
        radians = descendant
    end

    _G.prop_setHeadOn = function(descendant)
        sortedArray = descendant
    end

    _G.prop_setSearchMode = function(descendant)
        fileName = descendant
    end
end

