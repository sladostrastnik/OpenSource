local existingPlayer = rows.Blobman:AddRightGroupbox("Toy Mod / Orbit")

existingPlayer:AddToggle(
    "OrbitAll",
    {
        Text = "Orbit All (Clockwise)", Default = false,
        Callback = function(player10)
            entityData.enabled = player10

            if player10 then
                if entityData.connection then
                    pcall(
                        function()
                            entityData.connection:Disconnect()
                        end
                    )

                    entityData.connection = nil
                end

                entityData.angle = 0

                entityData.connection = runService.RenderStepped:Connect(
                    function(alpha)
                        if not entityData.enabled then
                            return
                        end
                        entityData.angle = entityData.angle - entityData.speed * alpha
                        local userId
                        userId, userId = getCharInfo()
                        if not userId then
                            return
                        end
                        local screenSize = userId.Position
                        local openSet = {}

                        for prefix in pairs(_G.permOwnerList) do
                            if prefix and prefix.Parent then
                                local characterModel = prefix.Character
                                characterModel = characterModel and characterModel:FindFirstChild(
                                    "HumanoidRootPart"
                                )

                                if characterModel then
                                    table.insert(openSet, characterModel)
                                end
                            end
                        end

                        local top = #openSet
                        if top == 0 then
                            return
                        end
                        local screenPosition = 6.2831853071795862 / top

                        for k, panel in ipairs(openSet) do
                            local radians = entityData.angle + screenPosition * (k - 1)

                            pcall(
                                function()
                                    local sphereRadius = entityData.radius
                                    local blurRadius = entityData.radius
                                    panel.CFrame = CFrame.new(
                                        screenSize.X + math.cos(radians) * sphereRadius,
                                        screenSize.Y + entityData.height,
                                        screenSize.Z + math.sin(radians) * blurRadius
                                    )
                                end
                            )
                        end
                    end
                )

                _NOTIFY("Orbit All: Started!", 2)
            else
                if entityData.connection then
                    pcall(
                        function()
                            entityData.connection:Disconnect()
                        end
                    )

                    entityData.connection = nil
                end

                _NOTIFY("Orbit All: Stopped", 2)
            end
        end,
    }
)

