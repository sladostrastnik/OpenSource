                            )
                        end

                        if otherVector.CloneDist then
                            otherVector.CloneDist.Position = UDim2.new(
                                0, rotationAngle.X - 100, 0, rotationAngle.Y + total / 2 + 4
                            )
                        end

                        if otherVector.CloneLine and otherVector.CloneLine.Visible then
                            local result15 = grid.noksLineThickness
                            updateNoksLine(
                                otherVector.CloneLine, toTarget, Vector2.new(rotationAngle.X, rotationAngle.Y + total / 2),
