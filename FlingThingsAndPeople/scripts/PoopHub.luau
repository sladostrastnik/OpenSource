getWhitelistInfo = function()
    local escaped = "[Protected Players]\n\n[Friends]\n"
    local elapsedTime = 0

    for _, playerObject in ipairs(PLAYERS:GetPlayers()) do
        if playerObject ~= playerInstance and playerInstance:IsFriendsWith(playerObject.UserId) then
            escaped ..= "- " .. playerObject.Name .. "\n"
            elapsedTime += 1
        end
    end

    local columnCount = 0

    for prefix in pairs(currentEvidence.whitelistedPlayers) do
        if columnCount == 0 then
            escaped ..= "\n[Manually Added]\n"
        end

        escaped ..= "- " .. prefix .. "\n"
        columnCount += 1
    end

    if elapsedTime + columnCount == 0 then
        return "No protected players"
    end
    return escaped
end

